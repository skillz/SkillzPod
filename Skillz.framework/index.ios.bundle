taTimeoutIfNeeded();\n\n        function initializeDataCollector() {\n          if (!window.braintree || !window.braintree.client) {\n            postErrorPayment('braintree_sdk_unavailable', 'braintree_sdk_unavailable');\n            return;\n          }\n\n          braintree.client.create({authorization: authorization}, function (err, clientInstance) {\n            if (err) {\n              postErrorPayment(err.message || 'client_create_failed', err.code);\n              return;\n            }\n            braintree.dataCollector.create(\n              {client: clientInstance, kount: true},\n              function (dcErr, dataCollectorInstance) {\n                if (dcErr) {\n                  postErrorPayment(dcErr.message || 'data_collector_create_failed', dcErr.code);\n                  return;\n                }\n                if (!dataCollectorInstance) {\n                  postErrorPayment(\n                    'data_collector_instance_missing',\n                    'data_collector_instance_missing'\n                  );\n                  return;\n                }\n                if (deviceDataTimedOut) {\n                  return;\n                }\n                let deviceData = dataCollectorInstance.deviceData;\n                if (\n                  deviceData == null ||\n                  (typeof deviceData === 'string' && !String(deviceData).trim())\n                ) {\n                  postErrorPayment('missing_device_data', 'missing_device_data');\n                  return;\n                }\n                deviceDataDelivered = true;\n                clearDeviceDataTimeout();\n                postToNative(WV_TO_NATIVE.DEVICE_DATA, {\n                  device_data: deviceData,\n                });\n              }\n            );\n          });\n        }\n\n        async function bootstrapDataCollector() {\n          try {\n            await loadBraintreeDataCollectorSdk(braintreeJsVersion);\n            initializeDataCollector();\n  