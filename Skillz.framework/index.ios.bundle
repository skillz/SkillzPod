044c \u0438 \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e. \\n \\n","Don't Allow":"\u0417\u0430\u043f\u0440\u0435\u0442\u0438\u0442\u044c","It doesn't look like that worked. Please try again later.":"\u041a\u0430\u0436\u0435\u0442\u0441\u044f, \u043d\u0435 \u0432\u044b\u0448\u043b\u043e. \u041f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443 \u043f\u043e\u0437\u0434\u043d\u0435\u0435.","Let's Try Again!":"\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0435\u043c \u0435\u0449\u0451 \u0440\u0430\u0437!","Let's start with a practice game against {0}!":"\u041d\u0430\u0447\u043d\u0451\u043c \u0441 \u043e\u0431\u0443\u0447\u0430\u044e\u0449\u0435\u0439 \u0438\u0433\u0440\u044b \u043f\u0440\u043e\u0442\u0438\u0432 {0}!","Let's start with a practice game! Once you are done you will be matched to an opponent who played the same level":"\u041d\u0430\u0447\u043d\u0451\u043c \u0441 \u043e\u0431\u0443\u0447\u0430\u044e\u0449\u0435\u0439 \u0438\u0433\u0440\u044b! \u041f\u043e\u0441\u043b\u0435 \u043e\u0431\u0443\u0447\u0430\u044e\u0449\u0435\u0439 \u0438\u0433\u0440\u044b \u0432\u044b \u043f\u0435\u0440\u0435\u0439\u0434\u0451\u0442\u0435 \u043a \u043c\u0430\u0442\u0447\u0443 \u0441 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u043e\u043c, \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u0430\u0448\u0435\u043c\u0443 \u0443\u0440\u043e\u0432\u043d\u044e","Looking for {0} friends?":"\u0418\u0449\u0435\u0442\u0435 {0} \u0434\u0440\u0443\u0437\u0435\u0439?","PROMO CODE":"\u041f\u0420\u041e\u041c\u041e\u041a\u041e\u0414","Play now, we're finding your opponent":"\u0421\u044b\u0433\u0440\u0430\u0439\u0442\u0435 \u0441\u0435\u0439\u0447\u0430\u0441, \u043c\u044b \u043f\u043e\u0434\u044b\u0441\u043a\u0438\u0432\u0430\u0435\u043c \u0432\u0430\u043c \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430","Promo Bonus Applied":"\u041f\u0440\u0438\u043c\u0435\u043d\u0451\u043d \u0431\u043e\u043d\u0443\u0441 \u043f\u043e \u043f\u0440\u043e\u043c\u043e\u043a\u043e\u0434\u0443","Promo Code is Invalid":"\u041d\u0435\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u043e\u043c\u043e\u043a\u043e\u0434","Skillz takes cheating very seriously. If you have any questions, you can always contact Skillz support in our \"Help and Support\" menu! Tap \"Next\" to play again!":"Skillz \u043d\u0435 \u0442\u0435\u0440\u043f\u0438\u0442 \u043d\u0435\u0447\u0435\u0441\u0442\u043d\u043e\u0439 \u0438\u0433\u0440\u044b. \u041f\u0440\u0438 \u0432\u043e\u0437\u043d\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u0438 \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432 \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0432 \u043b\u044e\u0431\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u044c\u0441\u044f \u0432 \u0441\u043b\u0443\u0436\u0431\u0443 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438 Skillz, \u043f\u0435\u0440\u0435\u0439\u0434\u044f \u0432 \u043c\u0435\u043d\u044e \"\u041f\u043e\u043c\u043e\u0449\u044c \u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430\"! \u0427\u0442\u043e\u0431\u044b \u0441\u044b\u0433\u0440\u0430\u0442\u044c \u0435\u0449\u0451, \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \"\u0414\u0430\u043b\u0435\u0435\"!","The more you play, the better we are at matching you against players of a similar skill level.  Tap \"Next\" to play again!":"\u0427\u0435\u043c \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u044b \u0438\u0433\u0440\u0430\u0435\u0442\u0435, \u0442\u0435\u043c \u043b\u0443\u0447\u0448\u0435 \u043c\u044b \u0441\u043c\u043e\u0436\u0435\u043c \u043f\u043e\u0434\u043e\u0431\u0440\u0430\u0442\u044c \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u043e\u0432, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0432\u0430\u043c \u043f\u043e \u0443\u0440\u043e\u0432\u043d\u044e \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430.  \u0427\u0442\u043e\u0431\u044b \u0441\u044b\u0433\u0440\u0430\u0442\u044c \u0435\u0449\u0451, \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \"\u0414\u0430\u043b\u0435\u0435\"!","To ensure fairness, you and your opponent will always play the same level in each match. Tap \"Next\" to play again!":"\u0412 \u043a\u0430\u0436\u0434\u043e\u043c \u043c\u0430\u0442\u0447\u0435 \u0432\u044b \u0438 \u0432\u0430\u0448 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a \u0431\u0443\u0434\u0435\u0442\u0435 \u0438\u0433\u0440\u0430\u0442\u044c \u043d\u0430 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435, \u0447\u0442\u043e \u0441\u0442\u0430\u043d\u0435\u0442 \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0435\u0439 \u0447\u0435\u0441\u0442\u043d\u043e\u0439 \u0438\u0433\u0440\u044b. \u0427\u0442\u043e\u0431\u044b \u0441\u044b\u0433\u0440\u0430\u0442\u044c \u0435\u0449\u0451, \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \"\u0414\u0430\u043b\u0435\u0435\"!","View each player's score after each match":"\u041f\u0440\u043e\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044c \u0431\u0430\u043b\u043b\u044b \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0438\u0433\u0440\u043e\u043a\u0430 \u043f\u043e\u0441\u043b\u0435 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043c\u0430\u0442\u0447\u0430","We're waiting for an opponent. Enable push notifications so we can alert you when your match is complete.":"\u041e\u0436\u0438\u0434\u0430\u0435\u043c \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430. \u0412\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0438\u0435 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u0443\u0437\u043d\u0430\u0442\u044c \u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0438 \u043c\u0430\u0442\u0447\u0430.","We're waiting for your opponent to accept the challenge. If push notifications are turned on, you'll receive a notification when the match is complete.":"\u041e\u0436\u0438\u0434\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u0438\u043d\u044f\u0442\u0438\u0435 \u0432\u044b\u0437\u043e\u0432\u0430 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u043e\u043c. \u0415\u0441\u043b\u0438 \u043f\u0440\u0438\u043d\u0443\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0430 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0430, \u0432\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435 \u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0438 \u043c\u0430\u0442\u0447\u0430.","You have redeemed a {0}. You will receive a confirmation email shortly. Play on!":"\u041f\u043e\u043b\u0443\u0447\u0435\u043d\u043e: {0}. \u0421\u043a\u043e\u0440\u043e \u0432\u0430\u043c \u0431\u0443\u0434\u0435\u0442 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e \u044d\u043b. \u043f\u0438\u0441\u044c\u043c\u043e \u0441 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435\u043c. \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0439\u0442\u0435 \u0438\u0433\u0440\u0430\u0442\u044c!","Your match history is summarized on the Home screen. Tap \"Play\" to find your next match!":"\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u043c\u0430\u0442\u0447\u0435\u0439 \u0431\u0443\u0434\u0435\u0442 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u044c\u0441\u044f \u043d\u0430 \u0433\u043b\u0430\u0432\u043d\u043e\u043c \u044d\u043a\u0440\u0430\u043d\u0435. \u0427\u0442\u043e\u0431\u044b \u043f\u043e\u0434\u043e\u0431\u0440\u0430\u0442\u044c \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u043c\u0430\u0442\u0447, \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \"\u0418\u0433\u0440\u0430\u0442\u044c\"!",more:"\u0415\u0429\u0401",your:"\u0432\u0430\u0448","{0} Conversation?":"\u0414\u0438\u0430\u043b\u043e\u0433 {0}?","Ticketz Tier":"\u0423\u0440\u043e\u0432\u0435\u043d\u044c Ticketz","Bonus cash can be used to pay entry fees and compete for prizes, but cannot be withdrawn.":"\u0411\u043e\u043d\u0443\u0441\u043d\u044b\u043c\u0438 \u0434\u0435\u043d\u044c\u0433\u0430\u043c\u0438 \u043c\u043e\u0436\u043d\u043e \u0443\u043f\u043b\u0430\u0442\u0438\u0442\u044c \u0432\u0441\u0442\u0443\u043f\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0432\u0437\u043d\u043e\u0441, \u0447\u0442\u043e\u0431\u044b \u0441\u0440\u0430\u0437\u0438\u0442\u044c\u0441\u044f \u0437\u0430 \u043f\u0440\u0438\u0437, \u043d\u043e \u0432\u044b\u0432\u0435\u0441\u0442\u0438 \u0438\u0445 \u043d\u0435\u043b\u044c\u0437\u044f.","Bonus cash cannot be withdrawn and will be forfeit upon withdrawal.":"\u0411\u043e\u043d\u0443\u0441\u043d\u044b\u0435 \u0434\u0435\u043d\u044c\u0433\u0438 \u0432\u044b\u0432\u0435\u0441\u0442\u0438 \u043d\u0435\u043b\u044c\u0437\u044f. \u0412\u044b \u043e\u0442\u043a\u0430\u0436\u0435\u0442\u0435\u0441\u044c \u043e\u0442 \u043d\u0438\u0445 \u043f\u0440\u0438 \u0432\u044b\u0432\u043e\u0434\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432.","Please enter a valid expiration date":"\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0432\u0435\u0440\u043d\u0443\u044e \u0434\u0430\u0442\u0443 \u0438\u0441\u0442\u0435\u0447\u0435\u043d\u0438\u044f","Please enter a valid zip/postal code":"\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0432\u0435\u0440\u043d\u044b\u0439 \u0438\u043d\u0434\u0435\u043a\u0441","Primary email":"\u041e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u044d\u043b. \u0430\u0434\u0440\u0435\u0441","This is your bonus cash reward for inputting a promo code. Bonus cash can be used to pay entry fees and compete for prizes, but cannot be withdrawn.":"\u0412\u043e\u0442 \u0432\u0430\u0448 \u0431\u043e\u043d\u0443\u0441 \u0437\u0430 \u0432\u0432\u0435\u0434\u0451\u043d\u043d\u044b\u0439 \u043f\u043e\u0434\u0430\u0440\u043e\u0447\u043d\u044b\u0439 \u043a\u043e\u0434. \u0411\u043e\u043d\u0443\u0441\u043d\u044b\u043c\u0438 \u0434\u0435\u043d\u044c\u0433\u0430\u043c\u0438 \u043c\u043e\u0436\u043d\u043e \u0443\u043f\u043b\u0430\u0442\u0438\u0442\u044c \u0432\u0441\u0442\u0443\u043f\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0432\u0437\u043d\u043e\u0441\u044b, \u0447\u0442\u043e\u0431\u044b \u0441\u0440\u0430\u0437\u0438\u0442\u044c\u0441\u044f \u0437\u0430 \u043f\u0440\u0438\u0437\u044b, \u043d\u043e \u0438\u0445 \u043d\u0435\u043b\u044c\u0437\u044f \u0432\u044b\u0432\u0435\u0441\u0442\u0438.","{0} in Bonus Cash will be forfeit upon withdrawal.":"\u041f\u0440\u0438 \u0432\u044b\u0432\u043e\u0434\u0435 \u0432\u044b \u043e\u0442\u043a\u0430\u0436\u0435\u0442\u0435\u0441\u044c \u043e\u0442 \u0431\u043e\u043d\u0443\u0441\u043d\u044b\u0445 \u0434\u0435\u043d\u0435\u0433 ({0})","*You may only change your Username once":"*\u0418\u043c\u044f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u043c\u043e\u0436\u043d\u043e \u043c\u0435\u043d\u044f\u0442\u044c \u043b\u0438\u0448\u044c \u0440\u0430\u0437","Add Contacts":"\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u044b","CREATE A NEW GAME":"\u041d\u0410\u0427\u0410\u0422\u042c \u041d\u041e\u0412\u0423\u042e \u0418\u0413\u0420\u0423","Challenge a Friend":"\u0412\u044b\u0437\u0432\u0430\u0442\u044c \u0434\u0440\u0443\u0433\u0430","Challenge a Friend for ":"\u0412\u044b\u0437\u0432\u0430\u0442\u044c \u0434\u0440\u0443\u0433\u0430: ","Challenges Available":"\u0415\u0441\u0442\u044c \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u044f","Claim Your Reward":"\u041f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u043f\u0440\u0438\u0437",Contacts:"\u041a\u043e\u043d