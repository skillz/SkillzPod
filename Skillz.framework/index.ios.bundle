3d\u043e\u0441",April:"\u0410\u043f\u0440\u0435\u043b\u044c","Apt, Unit, Bldg":"\u0414\u043e\u043c, \u043a\u043e\u0440\u043f\u0443\u0441, \u043a\u0432\u0430\u0440\u0442\u0438\u0440\u0430","Are you sure you want to block {0} from sending you chat messages?":"\u0417\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u0442\u044c {0} \u0438 \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u0432\u0430\u043c \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u0432 \u0447\u0430\u0442\u0435?","Are you sure you want to delete this payment method?":"\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u043c\u0435\u0442\u043e\u0434 \u043f\u043b\u0430\u0442\u0435\u0436\u0430?","Are you sure you want to exit Skillz?":"\u0412\u044b\u0439\u0442\u0438 \u0438\u0437 Skillz?","Are you sure you want to logout?":"\u0412\u044b\u0439\u0442\u0438?","Are you sure you want to skip the tutorial?":"\u041f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435?","Are you sure you want to unblock {0} from sending you chat messages?":"\u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u0442\u044c {0} \u0438 \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u0432\u0430\u043c \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u0432 \u0447\u0430\u0442\u0435?","Are you sure you want to unfriend {0}?":"\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0438\u0433\u0440\u043e\u043a\u0430 {0} \u0438\u0437 \u0434\u0440\u0443\u0437\u0435\u0439?","Are you sure you want to unmute\\n this message?":"\u0412\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0437\u0432\u0443\u043a \u0434\u043b\u044f\\n \u044d\u0442\u043e\u0433\u043e \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f?","As a top tier Skillz player, you'll get exclusive perks like a {0}X Ticketz multiplier and premium customer support.":"\u042f\u0432\u043b\u044f\u044f\u0441\u044c \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043b\u0443\u0447\u0448\u0438\u0445 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 Skillz, \u0432\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0435 \u044d\u043a\u0441\u043a\u043b\u044e\u0437\u0438\u0432\u043d\u044b\u0435 \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0430, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442 Ticketz ?{0} \u0438 \u043f\u0440\u0435\u043c\u0438\u0430\u043b\u044c\u043d\u0443\u044e \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0443 \u043a\u043b\u0438\u0435\u043d\u0442\u043e\u0432.","At least {0} characters are required in a comment. Please try again.":"\u041a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439 \u0434\u043e\u043b\u0436\u0435\u043d \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0442\u044c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 {0} \u0441\u0438\u043c\u0432. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437.",August:"\u0410\u0432\u0433\u0443\u0441\u0442","Automatic based on my activity":"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u043c\u043e\u0435\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438","Available for Withdrawal":"\u041c\u043e\u0436\u043d\u043e \u0432\u044b\u0432\u0435\u0441\u0442\u0438",Awaiting:"\u041e\u0436\u0438\u0434\u0430\u043d\u0438\u0435","Awaiting {0}":"\u041e\u0436\u0438\u0434\u0430\u043d\u0438\u0435 {0}",BACK:"\u041d\u0410\u0417\u0410\u0414",BAN:"\u0411\u041b\u041e\u041a\u0418\u0420\u041e\u0412\u041a\u0410","BEGIN MATCH NOW":"\u041d\u0410\u0427\u0410\u0422\u042c \u041c\u0410\u0422\u0427 \u0421\u0415\u0419\u0427\u0410\u0421","BEST SCORE:":"\u041b\u0423\u0427\u0428\u0418\u0419 \u0421\u0427\u0415\u0422:",BONUS:"\u0411\u041e\u041d\u0423\u0421","BONUS APPLIED":"\u0411\u041e\u041d\u0423\u0421 \u0418\u0421\u041f\u041e\u041b\u042c\u0417\u041e\u0412\u0410\u041d","BONUS CASH":"\u0411\u041e\u041d\u0423\u0421\u041d\u042b\u0415 \u0414\u0415\u041d\u042c\u0413\u0418","BONUS CASH:":"\u0411\u041e\u041d\u0423\u0421\u041d\u042b\u0415 \u0414\u0415\u041d\u042c\u0413\u0418:",BOT:"\u0411\u041e\u0422","BRACKET CANCELED":"\u0422\u0423\u0420\u041d\u0418\u0420\u041d\u0410\u042f \u0421\u0415\u0422\u041a\u0410 \u041e\u0422\u041c\u0415\u041d\u0415\u041d\u0410",Back:"\u041d\u0430\u0437\u0430\u0434",Balance:"\u0411\u0430\u043b\u0430\u043d\u0441",Ban:"\u0411\u0430\u043d","Before playing the next round, enable push notifications so you never miss your match.":"\u041f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u0441\u044b\u0433\u0440\u0430\u0442\u044c \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0440\u0430\u0443\u043d\u0434, \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u043f\u0440\u0438\u043d\u0443\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0443 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439, \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u0441\u0432\u043e\u0439 \u043c\u0430\u0442\u0447.","Begins In:":"\u041d\u0430\u0447\u0430\u043b\u043e \u0447\u0435\u0440\u0435\u0437:",Birthday:"\u0414\u0430\u0442\u0430 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f",Block:"\u0417\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u0442\u044c","Blocked Accounts":"\u0417\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0443\u0447. \u0437\u0430\u043f\u0438\u0441\u0438","Blocked Player":"\u0417\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0438\u0433\u0440\u043e\u043a","Blocked Players":"\u0417\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0438\u0433\u0440\u043e\u043a\u0438","Bonus Cash":"\u0411\u043e\u043d\u0443\u0441\u043d\u044b\u0435 \u0434\u0435\u043d\u044c\u0433\u0438","Bonus Cash can be used to pay entry fees and compete for prizes, but cannot be withdrawn.":"\u0411\u043e\u043d\u0443\u0441\u043d\u044b\u043c\u0438 \u0434\u0435\u043d\u044c\u0433\u0430\u043c\u0438 \u043c\u043e\u0436\u043d\u043e \u0443\u043f\u043b\u0430\u0442\u0438\u0442\u044c \u0432\u0441\u0442\u0443\u043f\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0432\u0437\u043d\u043e\u0441, \u0447\u0442\u043e\u0431\u044b \u0441\u0440\u0430\u0437\u0438\u0442\u044c\u0441\u044f \u0437\u0430 \u043f\u0440\u0438\u0437, \u043d\u043e \u0432\u044b\u0432\u0435\u0441\u0442\u0438 \u0438\u0445 \u043d\u0435\u043b\u044c\u0437\u044f.","Bonus cash can be used to enter tournaments to win real cash! Bonus cash cannot be withdrawn.":"\u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0432\u043e\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0431\u043e\u043d\u0443\u0441\u043d\u044b\u043c\u0438 \u0434\u0435\u043d\u044c\u0433\u0430\u043c\u0438 \u0434\u043b\u044f \u0443\u0447\u0430\u0441\u0442\u0438\u044f \u0432 \u0442\u0443\u0440\u043d\u0438\u0440\u0430\u0445, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0438\u0433\u0440\u0430\u0442\u044c \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0435 \u0434\u0435\u043d\u044c\u0433\u0438! \u0411\u043e\u043d\u0443\u0441\u043d\u044b\u0435 \u0434\u0435\u043d\u044c\u0433\u0438 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0432\u0435\u0441\u0442\u0438.","Bonus cash cannot be withdrawn. All Bonus cash will be forfeited when you withdraw.":"\u0411\u043e\u043d\u0443\u0441\u043d\u044b\u0435 \u0434\u0435\u043d\u044c\u0433\u0438 \u043d\u0435\u043b\u044c\u0437\u044f \u0432\u044b\u0432\u0435\u0441\u0442\u0438. \u041e\u043d\u0438 \u0431\u0443\u0434\u0443\u0442 \u0443\u0442\u0435\u0440\u044f\u043d\u044b \u043f\u0440\u0438 \u0432\u044b\u0432\u043e\u0434\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432.","Bracket Cancellation Note":"\u0417\u0430\u043c\u0435\u0442\u043a\u0430 \u043f\u043e \u043f\u043e\u0432\u043e\u0434\u0443 \u043e\u0442\u043c\u0435\u043d\u044b \u0442\u0443\u0440\u043d\u0438\u0440\u043d\u043e\u0439 \u0441\u0435\u0442\u043a\u0438","Bracket Details":"\u0414\u0435\u0442\u0430\u043b\u0438 \u0442\u0443\u0440\u043d\u0438\u0440\u043d\u043e\u0439 \u0441\u0435\u0442\u043a\u0438","Bracket Tournament":"\u0413\u0440\u0443\u043f\u043f\u043e\u0432\u043e\u0439 \u0442\u0443\u0440\u043d\u0438\u0440",BracketVersus:"BracketVersus","But if you do not earn any Ticketz in June, you will drop down to {0} Tier in July.":"\u041e\u0434\u043d\u0430\u043a\u043e \u0435\u0441\u043b\u0438 \u0432 \u0438\u044e\u043d\u0435 \u0432\u044b \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u043d\u0438 \u043e\u0434\u043d\u043e\u0433\u043e Ticketz, \u0432 \u0438\u044e\u043b\u0435 \u0432\u0430\u0448 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0443\u043f\u0430\u0434\u0451\u0442 \u0434\u043e {0}.","By tapping 'Next', I agree to the Terms of Service and the Privacy Policy.":"\u041d\u0430\u0436\u0438\u043c\u0430\u044f \xab\u0414\u0430\u043b\u0435\u0435\xbb, \u044f \u0441\u043e\u0433\u043b\u0430\u0448\u0430\u044e\u0441\u044c \u0441 \u0423\u0441\u043b\u043e\u0432\u0438\u044f\u043c\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u041f\u043e\u043b\u0438\u0442\u0438\u043a\u043e\u0439 \u043a\u043e\u043d\u0444\u0438\u0434\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438.","By verifying your email, you'll be eligible for exciting offers and invitations to private tournaments.":"\u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0432 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u044b\u0439 \u0430\u0434\u0440\u0435\u0