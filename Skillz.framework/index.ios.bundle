outline: 2px solid #4990e2;\n        outline-offset: 2px;\n      }\n\n      .save-card-text {\n        font-size: 14px;\n        font-weight: 400;\n        color: #999999;\n        padding-left: 10px;\n        line-height: 1.3;\n        user-select: none;\n        -webkit-user-select: none;\n      }\n    </style>\n  </head>\n  <body>\n    <form class=\"bt-form\" id=\"bt-card-form\" novalidate>\n      <div class=\"hf-init-overlay\" id=\"hf-init-overlay\" aria-hidden=\"true\">\n        <div class=\"hf-init-spinner\"></div>\n      </div>\n\n      <div class=\"field-block\">\n        <div class=\"hf-wrap\">\n          <div id=\"number\" class=\"hf\" aria-labelledby=\"label-number\"></div>\n          <span class=\"hf-label\" id=\"label-number\"></span>\n        </div>\n        <div class=\"field-err\" id=\"err-number\" role=\"alert\"></div>\n      </div>\n\n      <div class=\"row\">\n        <div class=\"col col--exp\">\n          <div class=\"hf-wrap\">\n            <div id=\"expirationDate\" class=\"hf\" aria-labelledby=\"label-expirationDate\"></div>\n            <span class=\"hf-label\" id=\"label-expirationDate\"></span>\n          </div>\n        </div>\n\n        <div class=\"col col--cvv\">\n          <div class=\"hf-wrap\">\n            <div id=\"cvv\" class=\"hf\" aria-labelledby=\"label-cvv\"></div>\n            <span class=\"hf-label\" id=\"label-cvv\"></span>\n          </div>\n        </div>\n\n        <div class=\"col col--zip\">\n          <div class=\"hf-wrap\">\n            <div id=\"postalCode\" class=\"hf\" aria-labelledby=\"label-postalCode\"></div>\n            <span class=\"hf-label\" id=\"label-postalCode\"></span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"field-err field-err--row\" id=\"err-row\" role=\"alert\"></div>\n\n      <label class=\"save-card-row\" for=\"save-card-checkbox\">\n        <input\n          type=\"checkbox\"\n          id=\"save-card-checkbox\"\n          checked\n          data-testid=\"credit_card_form_save_card_checkbox\"\n          aria-checked=\"true\"\n        />\n        <span class=\"save-card-text\" id=\"save-card-label-text\"></span>\n      </label>\n\n      <button id=\"submit-btn\" type=\"submit\">__SUBMIT_BUTTON_LABEL__</button>\n    </form>\n\n    <script>\n      (function () {\n        /* -------------------- Template inputs -------------------- */\n        const TEMPLATE_VALUES = {\n          webReferenceId: '__WEB_REFERENCE_ID__',\n          braintreeJsVersion: '__BRAINTREE_JS_VERSION__',\n          btnDisplay: '__BTN_DISPLAY__',\n          messagesJson: '__MESSAGES_JSON__',\n          clientToken: '__CLIENT_TOKEN__',\n          supportedCardBrands: '__SUPPORTED_CARD_BRANDS__',\n          wvToNativeJson: '__WV_TO_NATIVE_JSON__',\n          hideSaveCard: '__HIDE_SAVE_CARD__',\n        };\n        // Subscriptions vault the card unconditionally: hide the \"save card\"\n        // checkbox and force save on. Defaults false for the deposit flow (the\n        // token is absent \u2192 literal placeholder \u2192 treated as not-subscription).\n        const HIDE_SAVE_CARD = TEMPLATE_VALUES.hideSaveCard === 'true';\n\n        /* -------------------- Shared template runtime -------------------- */\n        __BRAINTREE_TEMPLATE_RUNTIME_JS__;\n        const runtime = window.__createBraintreeTemplateRuntime(TEMPLATE_VALUES);\n        const parseTemplateJson = runtime.parseTemplateJson;\n        const parseTemplateString = runtime.parseTemplateString;\n        const postToNative = runtime.postToNative;\n        const postErrorPayment = runtime.postErrorPayment;\n        const postWebViewReadyOnPageLoad = runtime.postWebViewReadyOnPageLoad;\n        const WV_TO_NATIVE = runtime.WV_TO_NATIVE;\n        const EMBEDDED_WEB_REFERENCE_ID = parseTemplateString(TEMPLATE_VALUES.webReferenceId, null);\n        postWebViewReadyOnPageLoad();\n\n        /* -------------------- SDK loading -------------------- */\n        function loadScript(src) {\n          return new Promise(function (resolve, reject) {\n            const script = document.createElement('script');\n            let settled = false;\n            const timeoutMs = 10000;\n            const timeoutId = setTimeout(function () {\n              if (settled) {\n                return;\n              }\n              settled = true;\n              reject(new Error('script_load_timeout: ' + src));\n            }, timeoutMs);\n            script.src = src;\n            script.async = false;\n            script.onload = function () {\n              if (settled) {\n                return;\n              }\n              settled = true;\n              clearTimeout(timeoutId);\n              resolve();\n            };\n            script.onerror = function () {\n              if (settled) {\n                return;\n              }\n              settled = true;\n              clearTimeout(timeoutId);\n              reject(new Error('script_load_failed: ' + src));\n            };\n            document.head.appendChild(script);\n          });\n        }\n\n        /** Critical path for first paint: load client + hosted-fields only; data-collector starts after hostedFields.create (avoids bandwidth contention with HF init). */\n        async function loadBraintreeClientAndHostedFieldsSdk(version) {\n          const base = 'https://js.braintreegateway.com/web/' + version + '/js/';\n          await Promise.all([\n            loadScript(base + 'client.min.js'),\n            loadScript(base + 'hosted-fields.min.js'),\n          ]);\n        }\n\n        /** Loads data-collector SDK and runs dataCollector.create; always settles so tokenize can proceed. */\n        function startBackgroundDataCollector(clientInstance, version) {\n          const base = 'https://js.braintreegateway.com/web/' + version + '/js/';\n          return loadScript(base + 'data-collector.min.js')\n            .then(function () {\n              if (!window.braintree || !window.braintree.dataCollector) {\n                return;\n              }\n              return new Promise(function (resolve) {\n                try {\n                  braintree.dataCollector.create(\n                    {client: clientInstance, kount: true},\n                    function (dcErr, dataCollectorInstance) {\n                      if (!dcErr && dataCollectorInstance && dataCollectorInstance.deviceData) {\n                        collectedDeviceData = dataCollectorInstance.deviceData;\n                        postToNative(WV_TO_NATIVE.DEVICE_DATA, {device_data: collectedDeviceData});\n                      }\n                      resolve();\n                    }\n                  );\n                } catch (_e) {\n                  resolve();\n                }\n              });\n            })\n            .catch(function () {\n              return undefined;\n            });\n        }\n\n        /* -------------------- Input normalization -------------------- */\n        const BRAINTREE_SUPPORTED_CARD_BRANDS = [\n          'visa',\n          'mastercard',\n          'american-express',\n          'diners-club',\n          'discover',\n          'jcb',\n          'union-pay',\n          'maestro',\n          'elo',\n          'mir',\n          'hiper',\n          'hipercard',\n        ];\n\n        function normalizeSupportedCardBrands(rawValue) {\n          if (Array.isArray(rawValue)) {\n            const normalizedPaymentTypes = rawValue\n              .map(function (type) {\n                return typeof type === 'string' ? type.toLowerCase() : '';\n              })\n              .map(function (type) {\n                return type === 'amex' ? 'american-express' : type;\n              });\n\n            return BRAINTREE_SUPPORTED_CARD_BRANDS.reduce(function (acc, brand) {\n              acc[brand] = normalizedPaymentTypes.indexOf(brand) !== -1;\n              return acc;\n            }, {});\n          }\n\n          if (rawValue && typeof rawValue === 'object') {\n            return BRAINTREE_SUPPORTED_CARD_BRANDS.reduce(function (acc, brand) {\n              acc[brand] = !!rawValue[brand];\n              return acc;\n            }, {});\n          }\n\n          return null;\n        }\n\n        const braintreeJsVersion = parseTemplateString(TEMPLATE_VALUES.braintreeJsVersion);\n        if (!braintreeJsVersion) {\n          postErrorPayment('missing_braintree_js_version', 'missing_braintree_js_version');\n          return;\n        }\n        const btnDisplay = parseTemplateString(TEMPLATE_VALUES.btnDisplay, 'block');\n        const authorization = parseTemplateJson(TEMPLATE_VALUES.clientToken);\n        const MESSAGES = parseTemplateJson(TEMPLATE_VALUES.messagesJson);\n        const supportedCardBrandsRaw = parseTemplateJson(TEMPLATE_VALUES.supportedCardBrands);\n        const supportedCardBrands = normalizeSupportedCardBrands(supportedCardBrandsRaw);\n\n        /* -------------------- DOM state -------------------- */\n        const submitBtn = document.getElementById('submit-btn');\n        const cardForm = document.getElementById('bt-card-form');\n        const saveCardCheckboxEl = document.getElementById('save-card-checkbox');\n        const saveCardLabelEl = document.getElementById('save-card-label-text');\n        const formOverlay = document.getElementById('hf-init-overlay');\n\n        function hideFormOverlay() {\n          if (!formOverlay) {\n            return;\n          }\n          formOverlay.style.opacity = '0';\n          setTimeout(function () {\n            if (formOverlay.parentNode) {\n              formOverlay.parentNode.removeChild(formOverlay);\n            }\n          }, 200);\n        }\n\n        let initFailurePosted = false;\n\n        function postInitErrorPayment(message, code) {\n          if (initFailurePosted) {\n            return;\n          }\n          initFailurePosted = true;\n          postErrorPayment(message, code);\n        }\n\n        if (saveCardLabelEl && MESSAGES.saveCardDetails) {\n          saveCardLabelEl.textContent = MESSAGES.saveCardDetails;\n        }\n\n        if (HIDE_SAVE_CARD) {\n          // Subscription: hide the whole save-card row. The checkbox stays in the\n          // DOM (checked) but is never shown; save is forced true at submit time.\n          const saveCardRowEl = saveCardCheckboxEl\n            ? saveCardCheckboxEl.closest('.save-card-row')\n            : null;\n          if (saveCardRowEl) {\n            saveCardRowEl.style.display = 'none';\n          }\n          if (saveCardCheckboxEl) {\n            saveCardCheckboxEl.checked = true;\n          }\n        }\n\n        if (saveCardCheckboxEl) {\n          saveCardCheckboxEl.addEventListener('change', function () {\n            saveCardCheckboxEl.setAttribute(\n              'aria-checked',\n              saveCardCheckboxEl.checked ? 'true' : 'false'\n            );\n          });\n        }\n\n        if (submitBtn) {\n          submitBtn.style.display = btnDisplay === 'none' ? 'none' : 'block';\n          if (submitBtn.style.display !== 'none') {\n            submitBtn.disabled = true;\n          }\n        }\n\n        if (cardForm) {\n          cardForm.addEventListener('submit', function (e) {\n            e.preventDefault();\n            if (typeof window.__braintreeRequestTokenize === 'function') {\n              window.__braintreeRequestTokenize();\n            }\n          });\n        }\n\n        /* -------------------- Native message handling -------------------- */\n        function onNativePaymentSubmit() {\n          function runTokenize() {\n            if (typeof window.__braintreeRequestTokenize === 'function') {\n              window.__braintreeRequestTokenize();\n              return true;\n            }\n            return false;\n          }\n\n          if (runTokenize()) {\n            return;\n          }\n\n          let attempts = 0;\n          const timer = setInterval(function () {\n            attempts += 1;\n            if (runTokenize() || attempts >= 40) {\n              clearInterval(timer);\n              if (attempts >= 40 && typeof window.__braintreeRequestTokenize !== 'function') {\n                postErrorPayment(\n                  'payment_submit_before_ready: Braintree tokenize was not ready',\n                  'payment_submit_before_ready'\n                );\n              }\n            }\n          }, 50);\n        }\n\n        window.addEventListener('payment_submit', onNativePaymentSubmit);\n\n        if (!authorization) {\n          postErrorPayment('missing_authorization', 'missing_authorization');\n          return;\n        }\n        if (!MESSAGES) {\n          postErrorPayment('missing_messages_json', 'missing_messages_json');\n          return;\n        }\n        if (!supportedCardBrands) {\n          postErrorPayment('missing_supported_card_brands', 'missing_supported_card_brands');\n          return;\n        }\n\n        let collectedDeviceData = null;\n        let lastFields = null;\n        let focusField = null;\n        let isCardSupported = true;\n        let isTokenizing = false;\n        let tokenizeWatchdogTimer = null;\n        let autoAdvanceDebounce = null;\n        const FIELD_IDS = ['number', 'expirationDate', 'cvv', 'postalCode'];\n\n        function isHostedFieldsFormValid(fields) {\n          if (!fields) {\n            return false;\n          }\n          return Object.keys(fields).every(function (k) {\n            return fields[k].isValid;\n          });\n        }\n\n        function syncWebSubmitButtonWithValidity() {\n          if (!submitBtn || submitBtn.style.display === 'none') {\n            return;\n          }\n          submitBtn.disabled = !isHostedFieldsFormValid(lastFields);\n        }\n\n        function clearTokenizeWatchdog() {\n          if (tokenizeWatchdogTimer !== null) {\n            clearTimeout(tokenizeWatchdogTimer);\n            tokenizeWatchdogTimer = null;\n          }\n        }\n\n        function getCardTypeForDeposit(details) {\n          if (!details || typeof details !== 'object') {\n            return null;\n          }\n          const raw = details.cardType;\n          if (typeof raw !== 'string' || !raw) {\n            return null;\n          }\n          return raw.replace(/\\s+/g, '').toUpperCase();\n        }\n\n        function hasFieldError(st) {\n          return !!st && ((st.isValid === false && !st.isEmpty) || st.isPotentiallyValid === false);\n        }\n\n        function shouldShowRowFieldError(fieldId) {\n          const st = lastFields && lastFields[fieldId];\n          return hasFieldError(st);\n        }\n\n        function setLabelText(fieldId, text) {\n          const el = document.getElementById('label-' + fieldId);\n          if (!el) {\n            return;\n          }\n          el.textContent = text || '';\n        }\n\n        function setFieldLabelActive(fieldId, on) {\n          const el = document.getElementById('label-' + fieldId);\n          if (!el) {\n            return;\n          }\n          if (on) {\n            el.classList.add('hf-label--active');\n          } else {\n            el.classList.remove('hf-label--active');\n          }\n        }\n\n        function setFieldLabelFocused(fieldId, on) {\n          const el = document.getElementById('label-' + fieldId);\n          if (!el) {\n            return;\n          }\n          if (on) {\n            el.classList.add('hf-label--focused');\n          } else {\n            el.classList.remove('hf-label--focused');\n          }\n        }\n\n        function setFieldFocusClass(fieldId, on) {\n          const el = document.getElementById(fieldId);\n          if (!el) {\n            return;\n          }\n          if (on) {\n            el.classList.add('hf--focused');\n          } else {\n            el.classList.remove('hf--focused');\n          }\n        }\n\n        function shouldFloatLabel(fieldId) {\n          if (focusField === fieldId) {\n            return true;\n          }\n          const st = lastFields && lastFields[fieldId];\n          return !!(st && !st.isEmpty);\n        }\n\n        function updateFloatingLabels() {\n          FIELD_IDS.forEach(function (fieldId) {\n            const active = shouldFloatLabel(fieldId);\n            const focused = focusField === fieldId;\n            setFieldLabelActive(fieldId, active);\n            setFieldLabelFocused(fieldId, focused);\n            setFieldFocusClass(fieldId, focused);\n          });\n        }\n\n        function setFieldErrorClass(fieldId, on) {\n          const el = document.getElementById(fieldId);\n          if (!el) {\n            return;\n          }\n          if (on) {\n            el.classList.add('hf--error');\n          } else {\n            el.classList.remove('hf--error');\n          }\n        }\n\n        function getNextField(fieldId) {\n          if (fieldId === 'number') {\n            return 'expirationDate';\n          }\n          if (fieldId === 'expirationDate') {\n            return 'cvv';\n          }\n          if (fieldId === 'cvv') {\n            return 'postalCode';\n          }\n          return null;\n        }\n\n        function resolveAdvanceSourceField(event) {\n          if (event && event.emittedBy) {\n            return event.emittedBy;\n          }\n          if (focusField) {\n            return focusField;\n          }\n          const f = (event && event.fields) || lastFields;\n          if (!f) {\n            return null;\n          }\n          if (f.number && f.number.isValid && f.expirationDate && f.expirationDate.isEmpty) {\n            return 'number';\n          }\n          if (f.expirationDate && f.expirationDate.isValid && f.cvv && f.cvv.isEmpty) {\n            return 'expirationDate';\n          }\n          if (f.cvv && f.cvv.isValid && f.postalCode && f.postalCode.isEmpty) {\n            return 'cvv';\n          }\n          return null;\n        }\n\n        function moveCaretToHostedField(hostedFieldsInstance, nextField) {\n          function focusOnce() {\n            try {\n              hostedFieldsInstance.focus(nextField);\n            } catch (err) {}\n          }\n\n          function focusOnNextFrames() {\n            if (typeof requestAnimationFrame === 'function') {\n              requestAnimationFrame(function () {\n                requestAnimationFrame(focusOnce);\n              });\n            } else {\n              setTimeout(focusOnce, 16);\n            }\n          }\n\n          let blurDone = false;\n\n          function afterBlur() {\n            if (blurDone) {\n              return;\n            }\n            blurDone = true;\n            focusOnNextFrames();\n          }\n\n          if (typeof hostedFieldsInstance.blur === 'function') {\n            try {\n              hostedFieldsInstance.blur(afterBlur);\n              setTimeout(afterBlur, 90);\n            } catch (errBlur) {\n              focusOnNextFrames();\n            }\n            return;\n          }\n\n          focusOnNextFrames();\n        }\n\n        function maybeAutoAdvance(hostedFieldsInstance, fieldId, fieldsFromEvent) {\n          if (!fieldId) {\n            return;\n          }\n          const bucket = fieldsFromEvent || lastFields;\n          const st = bucket && bucket[fieldId];\n          if (!st || !st.isValid) {\n            return;\n          }\n          const nextField = getNextField(fieldId);\n          if (!nextField) {\n            return;\n          }\n          if (autoAdvanceDebounce) {\n            clearTimeout(autoAdvanceDebounce);\n          }\n          autoAdvanceDebounce = setTimeout(function () {\n            autoAdvanceDebounce = null;\n            const again = lastFields && lastFields[fieldId];\n            if (!again || !again.isValid) {\n              return;\n            }\n            moveCaretToHostedField(hostedFieldsInstance, nextField);\n          }, 8);\n        }\n\n        function setInlineFieldError(elementId, show, message) {\n          const el = document.getElementById(elementId);\n          if (!el) {\n            return;\n          }\n          el.textContent = show && message ? message : '';\n          el.style.display = show && message ? 'block' : 'none';\n        }\n\n        const ROW_FIELD_IDS = ['expirationDate', 'cvv', 'postalCode'];\n\n        function getInvalidRowFieldIdsOrdered() {\n          const ids = [];\n          ROW_FIELD_IDS.forEach(function (k) {\n            if (shouldShowRowFieldError(k)) {\n              ids.push(k);\n            }\n          });\n          return ids;\n        }\n\n        function rowCombinedErrorMessage() {\n          const ids = getInvalidRowFieldIdsOrdered();\n          if (!ids.length) {\n            return '';\n          }\n          const names = ids.map(function (id) {\n            return (MESSAGES.names && MESSAGES.names[id]) || id;\n          });\n          const ph0 = MESSAGES.ph0 != null ? MESSAGES.ph0 : '{0}';\n          const ph1 = MESSAGES.ph1 != null ? MESSAGES.ph1 : '{1}';\n          const ph2 = MESSAGES.ph2 != null ? MESSAGES.ph2 : '{2}';\n          if (names.length === 1) {\n            return (MESSAGES.tplCombined1 || '').split(ph0).join(names[0]);\n          }\n          if (names.length === 2) {\n            return (MESSAGES.tplCombined2 || '')\n              .split(ph0)\n              .join(names[0])\n              .split(ph1)\n              .join(names[1]);\n          }\n          return (MESSAGES.tplCombined3 || '')\n            .split(ph0)\n            .join(names[0])\n            .split(ph1)\n            .join(names[1])\n            .split(ph2)\n            .join(names[2]);\n        }\n\n        function updateErrorUI() {\n          const nf = lastFields && lastFields.number;\n          const showNumErr = hasFieldError(nf);\n          const numberComplete = !!(nf && nf.isValid);\n\n          const numMsg =\n            !isCardSupported && numberComplete ? MESSAGES.errUnsupportedBrand : MESSAGES.errNumber;\n\n          setInlineFieldError('err-number', showNumErr, numMsg);\n\n          const rowMsg = rowCombinedErrorMessage();\n          setInlineFieldError('err-row', !!rowMsg, rowMsg);\n\n          setFieldErrorClass('number', hasFieldError(nf));\n          setFieldErrorClass('expirationDate', shouldShowRowFieldError('expirationDate'));\n          setFieldErrorClass('cvv', shouldShowRowFieldError('cvv'));\n          setFieldErrorClass('postalCode', shouldShowRowFieldError('postalCode'));\n          updateFloatingLabels();\n        }\n\n        /* -------------------- Hosted-fields initialization -------------------- */\n        function initializeBraintree() {\n          if (!window.braintree || !window.braintree.client) {\n            postErrorPayment('braintree_sdk_unavailable', 'braintree_sdk_unavailable');\n            return;\n          }\n\n          braintree.client.create({authorization: authorization}, function (err, clientInstance) {\n            if (err) {\n              postErrorPayment(err.message || 'client_create_failed', err.code);\n              return;\n            }\n\n            /** Filled after hosted fields are ready so data-collector.js does not compete with HF init. */\n            let dataCollectorSetupPromise = Promise.resolve();\n\n            braintree.hostedFields.create(\n              {\n                client: clientInstance,\n                fields: {\n                  number: {\n                    selector: '#number',\n                    rejectUnsupportedCards: true,\n                    supportedCardBrands: supportedCardBrands,\n                    placeholder: '',\n                  },\n                  cvv: {\n                    selector: '#cvv',\n                    placeholder: '',\n                  },\n                  expirationDate: {\n                    selector: '#expirationDate',\n                    placeholder: '',\n                  },\n                  postalCode: {\n                    selector: '#postalCode',\n                    placeholder: '',\n                  },\n                },\n                styles: {\n                  input: {\n                    'font-size': '16px',\n                    'line-height': '24px',\n                    'padding-top': '12px',\n                    'padding-bottom': '12px',\n                    'padding-left': '0',\n                    'padding-right': '0',\n                    'box-sizing': 'border-box',\n                    'caret-color': '#4990e2',\n                    color: '#4a4a4a',\n                    'background-color': 'transparent',\n                    '-webkit-font-smoothing': 'antialiased',\n                    outline: 'none',\n                    transition: 'color 0.15s ease',\n                  },\n                  'input::placeholder': {\n                    color: '#999999',\n                  },\n                  'input:focus': {\n                    color: '#4a4a4a',\n                    outline: 'none',\n                    'box-shadow': 'none',\n                  },\n                  '.valid': {\n                    color: '#4a4a4a',\n                  },\n                  '.invalid': {\n                    color: '#4a4a4a',\n                  },\n                },\n              },\n              function (err2, hostedFieldsInstance) {\n                if (err2) {\n                  hideFormOverlay();\n                  postErrorPayment(err2.message || 'hosted_fields_create_failed', err2.code);\n                  return;\n                }\n\n                hideFormOverlay();\n\n                dataCollectorSetupPromise = startBackgroundDataCollector(\n                  clientInstance,\n                  braintreeJsVersion\n                );\n\n                function doTokenize() {\n                  if (isTokenizing) {\n                    return;\n                  }\n\n                  isTokenizing = true;\n\n                  clearTokenizeWatchdog();\n                  tokenizeWatchdogTimer = setTimeout(function () {\n                    tokenizeWatchdogTimer = null;\n                    if (!isTokenizing) {\n                      return;\n                    }\n                    isTokenizing = false;\n                    postErrorPayment(\n                      'tokenize_timeout: Braintree tokenize did not respond',\n                      'tokenize_timeout'\n                    );\n                  }, 45000);\n\n                  function onTokenizeDone(err3, payload) {\n                    clearTokenizeWatchdog();\n                    isTokenizing = false;\n\n                    if (err3) {\n                      postErrorPayment(\n                        (err3 && err3.message) || 'tokenize_failed',\n                        err3 && err3.code\n                      );\n                      return;\n                    }\n\n                    const saveCardCb = document.getElementById('save-card-checkbox');\n                    // Subscriptions force save on (card vaulted for renewals);\n                    // otherwise honor the checkbox (missing box defaults to true).\n                    const savePaymentMethod = HIDE_SAVE_CARD\n                      ? true\n                      : !saveCardCb\n                        ? true\n                        : !!saveCardCb.checked;\n\n                    postToNative(WV_TO_NATIVE.NEW_PAYMENT, {\n                      nonce: payload.nonce,\n                      payment_method: 'NewCreditCard',\n                      save_payment_method: savePaymentMethod,\n                      card_type: getCardTypeForDeposit(payload.details),\n                      device_data: collectedDeviceData || '',\n                      webReferenceId: EMBEDDED_WEB_REFERENCE_ID,\n                      details:\n                        payload.details && typeof payload.details === 'object'\n                          ? payload.details\n                          : {},\n                    });\n                  }\n\n                  function runTokenizeAfterDeviceData() {\n                    try {\n                      hostedFieldsInstance.tokenize(onTokenizeDone);\n                    } catch (syncErr) {\n                      clearTokenizeWatchdog();\n                      isTokenizing = false;\n                      const syncMsg =\n                        (syncErr && syncErr.message) || String(syncErr) || 'tokenize_sync_throw';\n                      postErrorPayment(syncMsg, 'tokenize_sync_throw');\n                    }\n                  }\n\n                  dataCollectorSetupPromise\n                    .then(function () {\n                      runTokenizeAfterDeviceData();\n                    })\n                    .catch(function (dcErr) {\n                      console.error('data-collector setup failed, proceeding without device data:', dcErr);\n                      runTokenizeAfterDeviceData();\n                    });\n                }\n\n                hostedFieldsInstance.on('validityChange', function (event) {\n                  lastFields = event.fields;\n                  if (event && event.emittedBy) {\n                    focusField = event.emittedBy;\n                  }\n\n                  const formValid = isHostedFieldsFormValid(event.fields);\n\n                  postToNative(WV_TO_NATIVE.ENABLE_SUBMIT_BUTTON, {isValid: formValid});\n                  syncWebSubmitButtonWithValidity();\n                  updateErrorUI();\n                  maybeAutoAdvance(\n                    hostedFieldsInstance,\n                    resolveAdvanceSourceField(event),\n                    event.fields\n                  );\n                });\n\n                hostedFieldsInstance.on('input', function (event) {\n                  if (event && event.fields) {\n                    lastFields = event.fields;\n                  }\n                  if (event && event.emittedBy) {\n                    focusField = event.emittedBy;\n                  }\n                  maybeAutoAdvance(\n                    hostedFieldsInstance,\n                    resolveAdvanceSourceField(event),\n                    event.fields\n                  );\n                });\n\n                hostedFieldsInstance.on('cardTypeChange', function (event) {\n                  const cards = event && event.cards;\n                  if (cards && cards.length === 1) {\n                    const card = cards[0];\n                    isCardSupported = !!card.supported;\n                  } else {\n                    isCardSupported = true;\n                  }\n                  updateErrorUI();\n                });\n\n                hostedFieldsInstance.on('focus', function (e) {\n                  focusField = e.emittedBy;\n                  lastFields = e.fields;\n                  updateErrorUI();\n                });\n\n                hostedFieldsInstance.on('blur', function (e) {\n                  const emittedBy = e && e.emittedBy;\n                  lastFields = e.fields;\n                  updateErrorUI();\n                  setTimeout(function () {\n                    if (focusField === emittedBy) {\n                      focusField = null;\n                      updateErrorUI();\n                    }\n                  }, 0);\n                });\n\n                hostedFieldsInstance.on('notEmpty', function (e) {\n                  lastFields = e.fields;\n                  if (e && e.emittedBy) {\n                    focusField = e.emittedBy;\n                  }\n                  updateErrorUI();\n                  maybeAutoAdvance(hostedFieldsInstance, resolveAdvanceSourceField(e), e.fields);\n                });\n\n                hostedFieldsInstance.on('empty', function (e) {\n                  lastFields = e.fields;\n                  if (e.emittedBy === 'number') {\n                    isCardSupported = true;\n                  }\n                  updateErrorUI();\n                });\n\n                window.__braintreeRequestTokenize = function () {\n