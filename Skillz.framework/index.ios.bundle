ET $20 BONUS CASH\\nINVITE FRIENDS":"\u041f\u041e\u041b\u0423\u0427\u0418\u0422\u0415 \u0411\u041e\u041d\u0423\u0421 $20\\n\u041f\u0420\u0418\u0413\u041b\u0410\u0421\u0418\u0422\u0415 \u0414\u0420\u0423\u0417\u0415\u0419","GET BACK IN THE GAME":"\u0412\u0415\u0420\u041d\u0423\u0422\u042c\u0421\u042f \u0412 \u0418\u0413\u0420\u0423","GRAND PRIZE:":"\u0413\u041b\u0410\u0412\u041d\u042b\u0419 \u041f\u0420\u0418\u0417:",GUARANTEED:"\u0413\u0410\u0420\u0410\u041d\u0422\u0418\u0420\u041e\u0412\u0410\u041d\u041e",Game:"\u0418\u0433\u0440\u0430","Game Level":"\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0438\u0433\u0440\u044b","Game Results":"\u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0438\u0433\u0440\u044b","Get {0} in Bonus Cash":"\u041f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0431\u043e\u043d\u0443\u0441 {0}","Get Notified":"\u041f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435","Get Notified?":"\u041f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f?","Get bonus cash when you make a deposit. Bonus cash can't be withdrawn, but you can use it to enter competitions. Whatever you win, you keep!":"\u041f\u043e\u043b\u0443\u0447\u0430\u0439\u0442\u0435 \u0431\u043e\u043d\u0443\u0441\u043d\u044b\u0435 \u0434\u0435\u043d\u044c\u0433\u0438 \u043f\u0440\u0438 \u0432\u0437\u043d\u043e\u0441\u0435. \u0411\u043e\u043d\u0443\u0441\u043d\u044b\u0435 \u0434\u0435\u043d\u044c\u0433\u0438 \u043d\u0435\u043b\u044c\u0437\u044f \u0432\u044b\u0432\u0435\u0441\u0442\u0438, \u043e\u0434\u043d\u0430\u043a\u043e \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0432\u043e\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0438\u043c\u0438 \u0434\u043b\u044f \u0443\u0447\u0430\u0441\u0442\u0438\u044f \u0432 \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u044f\u0445. \u0412\u0435\u0441\u044c \u0432\u0430\u0448 \u0432\u044b\u0438\u0433\u0440\u044b\u0448 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f!","Go to the store to get more!":"\u0412 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435 \u0435\u0441\u0442\u044c \u0435\u0449\u0451!","Good game! Tap NEXT to find another live match.":"\u041e\u0442\u043b\u0438\u0447\u043d\u0430\u044f \u0438\u0433\u0440\u0430! \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \xab\u0414\u0410\u041b\u0415\u0415\xbb, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0439\u0442\u0438 \u0435\u0449\u0451 \u043e\u0434\u0438\u043d \u043c\u0430\u0442\u0447 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438.","Good game! Tap NEXT to play your first live match.":"\u041e\u0442\u043b\u0438\u0447\u043d\u0430\u044f \u0438\u0433\u0440\u0430! \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \xab\u0414\u0410\u041b\u0415\u0415\xbb, \u0447\u0442\u043e\u0431\u044b \u0441\u044b\u0433\u0440\u0430\u0442\u044c \u0441\u0432\u043e\u0439 \u043f\u0435\u0440\u0432\u044b\u0439 \u043c\u0430\u0442\u0447 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438.","Group Conversation":"\u0413\u0440\u0443\u043f\u043f\u043e\u0432\u043e\u0439 \u0434\u0438\u0430\u043b\u043e\u0433",HELP:"\u041f\u041e\u041c\u041e\u0429\u042c","Have A Match Code?":"\u0415\u0441\u0442\u044c \u043a\u043e\u0434 \u043c\u0430\u0442\u0447\u0430?","Have An Event Code?":"\u0423 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u043a\u043e\u0434 \u0441\u043e\u0431\u044b\u0442\u0438\u044f?","Have a match code?":"\u0415\u0441\u0442\u044c \u043a\u043e\u0434 \u043c\u0430\u0442\u0447\u0430?","Head to Head":"\u041f\u043e\u0435\u0434\u0438\u043d\u043e\u043a","Help Center":"\u0426\u0435\u043d\u0442\u0440 \u043f\u043e\u043c\u043e\u0449\u0438","Help us get you more competitors":"\u041f\u043e\u043c\u043e\u0433\u0438\u0442\u0435 \u043d\u0430\u0439\u0442\u0438 \u0432\u0430\u043c \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u043e\u0432","Here you can see your winnings.  Win or lose you always earn Ticketz which you can redeem in the Ticketz store!":"\u0417\u0434\u0435\u0441\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u044b \u0432\u0430\u0448\u0438 \u0432\u044b\u0438\u0433\u0440\u044b\u0448\u0438.  \u041d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432 \u0432\u044b \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0435\u0442\u0435 Ticketz, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0436\u043d\u043e \u0442\u0440\u0430\u0442\u0438\u0442\u044c \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435 Ticketz!","Hey ":"\u041f\u0440\u0438\u0432\u0435\u0442! ","Hey {0},":"\u041f\u0440\u0438\u0432\u0435\u0442 {0},",Home:"\u0412 \u043d\u0430\u0447\u0430\u043b\u043e","How You Earn":"\u041a\u0430\u043a \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c","How it Works":"\u041a\u0430\u043a \u044d\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442","How to Level Up":"\u041a\u0430\u043a \u043f\u043e\u0432\u044b\u0441\u0438\u0442\u044c \u0443\u0440\u043e\u0432\u0435\u043d\u044c","How to Win":"\u0418\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438","I consent to being contacted about Skillz products and offers.":"\u041f\u0440\u0438\u0441\u044b\u043b\u0430\u0439\u0442\u0435 \u043c\u043d\u0435 \u043f\u0438\u0441\u044c\u043c\u0430 \u043e \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430\u0445 \u0438 \u0443\u0441\u043b\u0443\u0433\u0430\u0445 Skillz.","I don't want to help":"\u041c\u043d\u0435 \u043d\u0435 \u043d\u0443\u0436\u043d\u0430 \u043f\u043e\u043c\u043e\u0449\u044c","I haven't chosen a shout out yet!":"\u042f \u0435\u0449\u0451 \u043d\u0435 \u0432\u044b\u0431\u0440\u0430\u043b(\u0430) \u043e\u0442\u043a\u043b\u0438\u043a!",ID:"ID","IN PRIZES":"\u0412 \u0412\u0418\u0414\u0415 \u041f\u0420\u0418\u0417\u041e\u0412","IN PRIZES GUARANTEED":"\u0412 \u0412\u0418\u0414\u0415 \u041f\u0420\u0418\u0417\u041e\u0412 \u0413\u0410\u0420\u0410\u041d\u0422\u0418\u0420\u041e\u0412\u0410\u041d\u041e","IN PROGRESS":"\u0412\u042b\u041f\u041e\u041b\u041d\u042f\u0415\u0422\u0421\u042f","INSUFFICIENT FUNDS":"\u041d\u0415\u0414\u041e\u0421\u0422\u0410\u0422\u041e\u0427\u041d\u041e \u0421\u0420\u0415\u0414\u0421\u0422\u0412",INVITE:"\u041f\u0420\u0418\u0413\u041b\u0410\u0421\u0418\u0422\u042c","If this tournament is cancelled due to a lack of participants, all entries will be cancelled and all entry fees will be fully refunded.":"\u041f\u0440\u0438 \u043e\u0442\u043c\u0435\u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u0433\u043e \u0442\u0443\u0440\u043d\u0438\u0440\u0430 \u0438\u0437-\u0437\u0430 \u043d\u0435\u0445\u0432\u0430\u0442\u043a\u0438 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432 \u0432\u0441\u0435 \u0431\u0438\u043b\u0435\u0442\u044b \u0431\u0443\u0434\u0443\u0442 \u0430\u043d\u043d\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u044b \u0438 \u0432\u0441\u0435 \u0432\u0441\u0442\u0443\u043f\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0432\u0437\u043d\u043e\u0441\u044b \u0431\u0443\u0434\u0443\u0442 \u0432\u043e\u0437\u043c\u0435\u0449\u0435\u043d\u044b \u0432 \u043f\u043e\u043b\u043d\u043e\u0439 \u043c\u0435\u0440\u0435.","If you earn {0} Ticketz in May, you will be {1} Tier in May and June. If you earn {2} Ticketz again in June, you will keep {3} Tier in July.":"\u0415\u0441\u043b\u0438 \u0432\u044b \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442\u0435 {0} Ticketz \u0432 \u043c\u0430\u0435, \u0442\u043e \u0432 \u043c\u0430\u0435 \u0438 \u0438\u044e\u043d\u0435 \u0443 \u0432\u0430\u0441 \u0431\u0443\u0434\u0435\u0442 \u0443\u0440\u043e\u0432\u0435\u043d\u044c {1}. \u0415\u0441\u043b\u0438 \u0432 \u0438\u044e\u043d\u0435 \u0432\u044b \u0441\u043d\u043e\u0432\u0430 \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442\u0435 {2} Ticketz, \u0442\u043e \u0432 \u0438\u044e\u043b\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435 \u0443\u0440\u043e\u0432\u0435\u043d\u044c {3}.","If you maintain {0} Tier for 12 straight months youa\u20ac\u2122ll earn another full year of {1} Tier.":"\u0415\u0441\u043b\u0438 \u0432\u044b \u0441\u043c\u043e\u0436\u0435\u0442\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0443\u0440\u043e\u0432\u0435\u043d\u044c {0} \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 12 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u043f\u043e\u0434\u0440\u044f\u0434, \u0442\u043e \u0432\u0435\u0441\u044c \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0433\u043e\u0434 \u0443 \u0432\u0430\u0441 \u0431\u0443\u0434\u0435\u0442 \u0443\u0440\u043e\u0432\u0435\u043d\u044c {1}.","If you maintain {0} Tier for a year, you are automatically {1} Tier for the next year.":"\u0415\u0441\u043b\u0438 \u0432\u044b \u0441\u043c\u043e\u0436\u0435\u0442\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0443\u0440\u043e\u0432\u0435\u043d\u044c {0} \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0433\u043e\u0434\u0430, \u0442\u043e \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0433\u043e\u0434 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0443\u0440\u043e\u0432\u0435\u043d\u044c {1}.","In Progress":"\u0412 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435","In order to redeem your prize, we need the following information.":"\u0427\u0442\u043e\u0431\u044b \u0432\u044b\u0434\u0430\u0442\u044c \u043f\u0440\u0438\u0437, \u043d\u0430\u043c \u043d\u0443\u0436\u043d\u044b \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f:","In order to redeem your prize, we need the following information:":"\u0414\u043b\u044f \u0432\u044b\u0434\u0430\u0447\u0438 \u0432\u0430\u0448\u0435\u0433\u043e \u043f\u0440\u0438\u0437\u0430 \u043d\u0430\u043c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f:","Incorrect password. Please try again.":"\u041d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0439 \u043f\u0430\u0440\u043e\u043b\u044c. \u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0441\u043d\u043e\u0432\u0430.","Increase your balance to play this match":"\u0423\u0432\u0435\u043b\u0438\u0447\u044c\u0442\u0435 \u0441\u0432\u043e\u0439 \u043e\u0441\u0442\u0430\u0442\u043e\u043a, \u0447\u0442\u043e\u0431\u044b \u0441\u044b\u0433\u0440\u0430\u0442\u044c \u0443\u043a\u0430\u0437\u0430\u043d\u043d\u044b\u0439 \u043c\u0430\u0442\u0447","Introducing Levels":"\u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u043c \u0443\u0440\u043e\u0432\u043d\u0438","Introducing Skillz Chat":"\u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u043c \u0447\u0430\u0442 Skillz","Introducing Skillz Levels":"\u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u043c \u0443\u0440\u043e\u0432\u043d\u0438 Skillz","Invalid Month":"\u041d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0439 \u043c\u0435\u0441\u044f\u0446","Invalid match code.":"\u041d\u0435\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043a\u043e\u0434 \u043c\u0430\u0442\u0447\u0430.","Invite Friends":"\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u044c \u0434\u0440\u0443\u0437\u0435\u0439","Invite New Friends!":"\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u0435 \u043d\u043e\u0432\u044b\u0445 \u0434\u0440\u0443\u0437\u0435\u0439!","Invite Players":"\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u044c \u0438\u0433\u0440\u043e\u043a\u043e\u0432","Invite Your Friends":"\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u0435 \u0434\u0440\u0443\u0437\u0435\u0439","Invite a friend":"\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u044c \u0434\u0440\u0443\u0433\u0430","Invite a friend from your contacts to play. Once they join the tournament, you'll earn another challenge!":"\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u0435 \u0434\u0440\u0443\u0433\u0430 \u0438\u0437 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043e\u0432 \u0441\u044b\u0433\u0440\u0430\u0442\u044c. \u041a\u043e\u0433\u0434\u0430 \u043e\u043d \u043f\u0440\u0438\u0434\u0451\u0442 \u043d\u0430 \u0442\u0443\u0440\u043d\u0438\u0440, \u0432\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0435\u0449\u0451 \u043e\u0434\u043d\u043e \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u0435!","Invite friends to Skillz to **get FREE Bonus Cash!**":"\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u0435 \u0434\u0440\u0443\u0437\u0435\u0439 \u0432 Skillz \u0438 **\u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0411\u0415\u0421\u041f\u041b\u0410\u0422\u041d\u042b\u0415 \u0431\u043e\u043d\u0443\u0441\u043d\u044b\u0435 \u0434\u0435\u043d\u044c\u0433\u0438!**","Invite friends to join and get bonus cash!":"\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u0435 \u0434\u0440\u0443\u0437\u0435\u0439 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0431\u043e\u043d\u0443\u0441\u043d\u044b\u0435 \u0434\u0435\u043d\u044c\u0433\u0438!","Invite new Skillz players so they can accept your tournament invite!":"\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0430\u0439\u0442\u0435 \u043d\u043e\u0432\u044b\u0445 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0432 Skillz, \u0447\u0442\u043e\u0431\u044b \u043e\u043d\u0438 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u043b\u0438 \u0432\u0430\u0448\u0438 \u0432\u044b\u0437\u043e\u0432\u044b \u043d\u0430 \u0442\u0443\u0440\u043d\u0438\u0440!","Invite sent to":"\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0432\u044b\u0441\u043b\u0430\u043d\u043e \u0430\u0434\u0440\u0435\u0441\u0430\u0442\u0443","Invite sent to your friend":"\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0432\u044b\u0441\u043b\u0430\u043d\u043e \u0434\u0440\u0443\u0433\u0443","Invite sent to {0}":"\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0432\u044b\u0441\u043b\u0430\u043d\u043e \u0430\u0434\u0440\u0435\u0441\u0430\u0442\u0443 {0}","Invite your friends":"\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u0435 \u0434\u0440\u0443\u0437\u0435\u0439","Invite your friends to join Skillz and play this tournament to earn more challenges!":"\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u0435 \u0434\u0440\u0443\u0437\u0435\u0439 \u0432 Skillz \u0438 \u0441\u044b\u0433\u0440\u0430\u0439\u0442\u0435 \u043d\u0430 \u044d\u0442\u043e\u043c \u0442\u0443\u0440\u043d\u0438\u0440\u0435, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043d\u043e\u0432\u044b\u0435 \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u044f.","Inviting Friends":"\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0434\u0440\u0443\u0437\u0435\u0439","JOIN NOW":"\u041f\u0420\u0418\u0421\u041e\u0415\u0414\u0418\u041d\u0418\u0422\u042c\u0421\u042f \u0421\u0415\u0419\u0427\u0410\u0421",January:"\u042f\u043d\u0432\u0430\u0440\u044c","Join Event":"\u041f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u044c\u0441\u044f \u043a \u0441\u043e\u0431\u044b\u0442\u0438\u044e","Join Match":"\u041f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u044c\u0441\u044f \u043a \u043c\u0430\u0442\u0447\u0443","Join me in competitive mobile gaming on Skillz! Use my promo code {0} to get {1} Bonus Cash when you make your first deposit in ANY Skillz game. Check out the games here:":"\u041f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u044f\u0439\u0441\u044f \u043a\u043e \u043c\u043d\u0435 \u043d\u0430 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435 \u0434\u043b\u044f \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u0439 \u043f\u043e \u043c\u043e\u0431\u0438\u043b\u044c\u043d\u044b\u043c \u0438\u0433\u0440\u0430\u043c Skillz! \u041a\u043e\u0433\u0434\u0430 \u0441\u0434\u0435\u043b\u0430\u0435\u0448\u044c \u043f\u0435\u0440\u0432\u044b\u0439 \u0432\u0437\u043d\u043e\u0441 \u0432 \u041b\u042e\u0411\u041e\u0419 \u0438\u0433\u0440\u0435 Skillz, \u0432\u0432\u0435\u0434\u0438 \u043c\u043e\u0439 \u043f\u0440\u043e\u043c\u043e\u043a\u043e\u0434 {0} \u0438 \u043f\u043e\u043b\u0443\u0447\u0438 \u0431\u043e\u043d\u0443\u0441 {1}. \u0421\u043c\u043e\u0442\u0440\u0438, \u043a\u0430\u043a\u0438\u0435 \u0438\u0433\u0440\u044b \u0437\u0434\u0435\u0441\u044c \u0435\u0441\u0442\u044c:","Joined ":"\u041f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435 ",July:"\u0418\u044e\u043b\u044c",June:"\u0418\u044e\u043d\u044c","Keep playing to climb tiers":"\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0439\u0442\u0435 \u0438\u0433\u0440\u0430\u0442\u044c, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0432\u044b\u0441\u0438\u0442\u044c \u0443\u0440\u043e\u0432\u0435\u043d\u044c.","Keep playing to maintain tier":"\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0439\u0442\u0435 \u0438\u0433\u0440\u0430\u0442\u044c, \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0443\u0440\u043e\u0432\u0435\u043d\u044c.",L:"L",LEADERBOARD:"\u0422\u0410\u0411\u041b\u0418\u0426\u0410 \u041b\u0418\u0414\u0415\u0420\u041e\u0412",LEAGUE:"\u041b\u0418\u0413\u0410","LEARN MORE":"\u0423\u0417\u041d\u0410\u0422\u042c \u0411\u041e\u041b\u042c\u0428\u0415","LESS ":"\u041c\u0415\u041d\u0415\u0415 ",LEVELS:"\u0423\u0420\u041e\u0412\u041d\u0418","LIMITED TIME OFFER!":"\u041f\u0420\u0415\u0414\u041b\u041e\u0416\u0415\u041d\u0418\u0415 \u0414\u0415\u0419\u0421\u0422\u0412\u0423\u0415\u0422 \u0412 \u0422\u0415\u0427\u0415\u041d\u0418\u0415 \u041e\u0413\u0420\u0410\u041d\u0418\u0427\u0415\u041d\u041d\u041e\u0413\u041e \u0412\u0420\u0415\u041c\u0415\u041d\u0418!",LOGIN:"\u0412\u0425\u041e\u0414","LOGIN BONUS":"\u041f\u0420\u0