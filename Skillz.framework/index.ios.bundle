e\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437 \u043f\u043e\u0437\u0436\u0435!","We need your location to determine eligibility for skill-based cash gaming in your region.":"\u041d\u0430\u043c \u043d\u0443\u0436\u043d\u043e \u0437\u043d\u0430\u0442\u044c, \u0433\u0434\u0435 \u0432\u044b \u0436\u0438\u0432\u0451\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c, \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u044b \u043b\u0438 \u0442\u0430\u043c \u0438\u0433\u0440\u044b \u043d\u0430 \u0434\u0435\u043d\u044c\u0433\u0438.","We need your location to determine eligibility for this tournament.":"\u0414\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u043f\u0440\u0430\u0432\u0430 \u043d\u0430 \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u044d\u0442\u043e\u043c \u0442\u0443\u0440\u043d\u0438\u0440\u0435 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0430 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0438.","We were unable to load your ad. You will still be awarded your {0}.":"\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0440\u0435\u043a\u043b\u0430\u043c\u0443, \u043d\u043e \u0432\u044b \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u043f\u0440\u0438\u0437: {0}.",Welcome:"\u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c","Welcome Back":"\u0421 \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435\u043c","Welcome back, claim todaya\u20ac\u2122s reward!":"\u0421 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435\u043c! \u041f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0441\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u044e\u044e \u043d\u0430\u0433\u0440\u0430\u0434\u0443!","Welcome to Leagues":"\u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0432 \u043b\u0438\u0433\u0438","Welcome to Skillz Chat":"\u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0432 \u0447\u0430\u0442 Skillz","Welcome to Ticketz!":"\u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0432 Ticketz!","Welcome to the Event!":"\u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u043d\u0430 \u0441\u043e\u0431\u044b\u0442\u0438\u0435!","Welcome to {0}! Practice while you wait for your event to start":"\u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0432 {0}! \u041f\u043e\u0442\u0440\u0435\u043d\u0438\u0440\u0443\u0439\u0442\u0435\u0441\u044c, \u043f\u043e\u043a\u0430 \u0436\u0434\u0451\u0442\u0435 \u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u043e\u0431\u044b\u0442\u0438\u044f.","Well fought! Tap PLAY AGAIN to find another live match.":"\u0412\u044b \u043e\u0442\u043b\u0438\u0447\u043d\u043e \u0438\u0433\u0440\u0430\u043b\u0438! \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \xab\u0418\u0413\u0420\u0410\u0422\u042c \u0415\u0429\u0415 \u0420\u0410\u0417\xbb, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0439\u0442\u0438 \u0434\u0440\u0443\u0433\u043e\u0439 \u043c\u0430\u0442\u0447 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438.","Wea\u20ac\u2122re finding you an opponent and will alert you when a match is found.":"\u0418\u0449\u0435\u043c \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430. \u041a\u043e\u0433\u0434\u0430 \u043d\u0430\u0439\u0434\u0451\u043c, \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043c \u0432\u0430\u043c \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435.","Wea\u20ac\u2122ve added your ":"\u041c\u044b \u0434\u043e\u0431\u0430\u0432\u0438\u043b\u0438: ","When they deposit {0}, **you'll both get another {1}!**":"\u041a\u043e\u0433\u0434\u0430 \u043e\u043d(\u0430) \u0432\u043d\u0435\u0441\u0451\u0442 {0}, **\u0432\u044b \u043e\u0431\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0435\u0449\u0451 \u043f\u043e {1}!**","When they deposit {0}, **you'll get another {1}**, and **they'll get another {2}!**":"\u041a\u043e\u0433\u0434\u0430 \u043e\u043d(\u0430) \u0432\u043d\u0435\u0441\u0451\u0442 {0}, **\u0432\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0435\u0449\u0451 {1}**, \u0430 **\u043e\u043d(\u0430) \u2014 \u0435\u0449\u0451 {2}!**","When they use your promo code to make their first Skillz deposit, **you'll both get {0}!**":"\u041a\u043e\u0433\u0434\u0430 \u043e\u043d(\u0430) \u0432\u0432\u0435\u0434\u0451\u0442 \u0432\u0430\u0448 \u043f\u0440\u043e\u043c\u043e\u043a\u043e\u0434 \u043f\u0440\u0438 \u0432\u043d\u0435\u0441\u0435\u043d\u0438\u0438 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0432\u0437\u043d\u043e\u0441\u0430 Skillz, **\u0432\u044b \u043e\u0431\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 {0}!**","When they use your promo code to make their first Skillz deposit, **you'll get {0}**, and **they'll get {1}!**":"\u041a\u043e\u0433\u0434\u0430 \u043e\u043d(\u0430) \u0432\u0432\u0435\u0434\u0451\u0442 \u0432\u0430\u0448 \u043f\u0440\u043e\u043c\u043e\u043a\u043e\u0434 \u043f\u0440\u0438 \u0432\u043d\u0435\u0441\u0435\u043d\u0438\u0438 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0432\u0437\u043d\u043e\u0441\u0430 Skillz, **\u0432\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 {0}**, \u0430 **\u043e\u043d(\u0430) \u2014 {1}!**","Win matches to level up faster!":"\u041f\u043e\u0431\u0435\u0436\u0434\u0430\u0439\u0442\u0435 \u0432 \u043c\u0430\u0442\u0447\u0430\u0445, \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0441\u0442\u0438 \u0431\u044b\u0441\u0442\u0440\u0435\u0435!","Win medals to climb the ranks!":"\u041f\u043e\u043b\u0443\u0447\u0430\u0439\u0442\u0435 \u043c\u0435\u0434\u0430\u043b\u0438 \u0438 \u0440\u0430\u0441\u0442\u0438\u0442\u0435 \u0432 \u0440\u0430\u043d\u0433\u0435!","Win or lose you earn Ticketz for every match. Save up your ticketz to redeem amazing prizes!":"Ticketz \u0434\u0430\u044e\u0442\u0441\u044f \u043a\u0430\u043a \u0437\u0430 \u043f\u043e\u0431\u0435\u0434\u0443, \u0442\u0430\u043a \u0438 \u0437\u0430 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0432 \u043a\u0430\u0436\u0434\u043e\u043c \u043c\u0430\u0442\u0447\u0435. \u041a\u043e\u043f\u0438\u0442\u0435 Ticketz, \u0447\u0442\u043e\u0431\u044b \u043e\u0431\u043c\u0435\u043d\u044f\u0442\u044c \u0438\u0445 \u043d\u0430 \u0446\u0435\u043d\u043d\u044b\u0435 \u043f\u0440\u0438\u0437\u044b!","Win or lose, you earn Ticketz after every match. Your tier increases as you earn more Ticketz.":"Ticketz \u0434\u0430\u044e\u0442\u0441\u044f \u043a\u0430\u043a \u0437\u0430 \u043f\u043e\u0431\u0435\u0434\u0443, \u0442\u0430\u043a \u0438 \u0437\u0430 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0432 \u043a\u0430\u0436\u0434\u043e\u043c \u043c\u0430\u0442\u0447\u0435. \u0427\u0435\u043c \u0431\u043e\u043b\u044c\u0448\u0435 \u0443 \u0432\u0430\u0441 Ticketz, \u0442\u0435\u043c \u0432\u044b\u0448\u0435 \u0432\u0430\u0448 \u0443\u0440\u043e\u0432\u0435\u043d\u044c.","Win or lose, you'll earn them with each match you play.":"\u041d\u0435\u0432\u0430\u0436\u043d\u043e, \u0432\u044b\u0438\u0433\u0440\u0430\u0435\u0442\u0435 \u0432\u044b \u0438\u043b\u0438 \u043d\u0435\u0442: \u0441\u0432\u043e\u0438 Ticketz \u0432\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0437\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u0441\u044b\u0433\u0440\u0430\u043d\u043d\u044b\u0439 \u043c\u0430\u0442\u0447.",Winner:"\u041f\u043e\u0431\u0435\u0434\u0438\u0442\u0435\u043b\u044c","Winnings were applied to your balance at the time of match conclusion.":"\u0412\u044b\u0438\u0433\u0440\u044b\u0448 \u0437\u0430\u0447\u0438\u0441\u043b\u0435\u043d \u043d\u0430 \u0432\u0430\u0448 \u0441\u0447\u0451\u0442 \u0432 \u043c\u043e\u043c\u0435\u043d\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u043c\u0430\u0442\u0447\u0430.",Withdraw:"\u0412\u044b\u0432\u043e\u0434","Withdraw Pending":"\u041d\u0435\u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043d\u043d\u044b\u0439 \u0432\u044b\u0432\u043e\u0434 \u0441\u0440\u0435\u0434\u0441\u0442\u0432","Withdraw {0}?":"\u0412\u044b\u0432\u0435\u0441\u0442\u0438 {0}?","Withdrawal Amount":"\u0421\u0443\u043c\u043c\u0430 \u0432\u044b\u0432\u043e\u0434\u0430","Withdrawal Details":"\u041e \u0432\u044b\u0432\u043e\u0434\u0435","Withdrawal Method":"\u0421\u043f\u043e\u0441\u043e\u0431 \u0432\u044b\u0432\u043e\u0434\u0430","Withdrawals under {0} are subject to a {1} processing fee.":"\u0417\u0430 \u0432\u044b\u0432\u043e\u0434 \u043c\u0435\u043d\u0435\u0435 {0} \u0431\u0435\u0440\u0451\u0442\u0441\u044f \u043f\u043b\u0430\u0442\u0430 \u0437\u0430 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0443: {1}","Withdrawals will be refunded via the original method when possible.":"\u041f\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0432\u044b\u0432\u043e\u0434 \u0431\u0443\u0434\u0435\u0442 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0451\u043d \u0438\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u044b\u043c \u0441\u043f\u043e\u0441\u043e\u0431\u043e\u043c.","Would You Like to Update Your Username?":"\u0421\u043c\u0435\u043d\u0438\u0442\u044c \u0438\u043c\u044f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f?","Would you like Skillz to send {0} an invite via SMS on your behalf?":"\u041f\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u044c Skillz \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u043e\u0442 \u0432\u0430\u0448\u0435\u0433\u043e \u0438\u043c\u0435\u043d\u0438 \u043f\u043e \u0421\u041c\u0421 \u0430\u0434\u0440\u0435\u0441\u0430\u0442\u0443 {0}?","Would you like to view this page in your web browser?":"\u041e\u0442\u043a\u0440\u044b\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u0432 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435?","Would you like us to notify you when {0} Event goes live?":"\u041f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435 \u043e {0} \u043d\u0430\u0447\u0430\u043b\u0435 \u0441\u043e\u0431\u044b\u0442\u0438\u044f?",YES:"\u0414\u0410","YOU LOST":"\u0412\u042b \u041f\u0420\u041e\u0418\u0413\u0420\u0410\u041b\u0418","YOU PLACED":"\u0412\u0410\u0428\u0415 \u041c\u0415\u0421\u0422\u041e","YOU PLACED {0}":"\u0412\u0410\u0428\u0415 \u041c\u0415\u0421\u0422\u041e {0}","YOU TIED":"\u0412\u042b \u0421\u042b\u0413\u0420\u0410\u041b\u0418 \u0412\u041d\u0418\u0427\u042c\u042e","YOU VS":"\u0412\u042b \u041f\u0420\u041e\u0422\u0418\u0412","YOU VS EVERYONE":"\u0412\u042b \u041f\u0420\u041e\u0422\u0418\u0412 \u0412\u0421\u0415\u0425","YOU WON":"\u0412\u042b \u0412\u042b\u0418\u0413\u0420\u0410\u041b\u0418","YOU WON!":"\u0412\u042b \u0412\u042b\u0418\u0413\u0420\u0410\u041b\u0418!","YOU'RE ABOUT TO PLAY A LIVE MATCH":"\u0412\u0410\u0428 \u041c\u0410\u0422\u0427 \u0412 \u0420\u0415\u0410\u041b\u042c\u041d\u041e\u041c \u0412\u0420\u0415\u041c\u0415\u041d\u0418 \u0412\u041e\u0422-\u0412\u041e\u0422 \u041d\u0410\u0427\u041d\u0415\u0422\u0421\u042f","YOUR CONNECTION STRENGTH HAS DROPPED":"\u0421\u041d\u0418\u0417\u0418\u041b\u0410\u0421\u042c \u0421\u041a\u041e\u0420\u041e\u0421\u0422\u042c \u0421\u0415\u0422\u0415\u0412\u041e\u0413\u041e \u041f\u041e\u0414\u041a\u041b\u042e\u0427\u0415\u041d\u0418\u042f","YOUR LEVELS":"\u0412\u0410\u0428\u0418 \u0423\u0420\u041e\u0412\u041d\u0418","YOUR SCORE":"\u0412\u0410\u0428 \u0421\u0427\u0415\u0422","YOUR SCORE:":"\u0412\u0410\u0428 \u0421\u0427\u0415\u0422:","YOUR TURN":"\u0412\u0410\u0428 \u0425\u041e\u0414",Yes:"\u0414\u0430","Yes, sign me up for news and updates from Skillz":"\u0414\u0430, \u043e\u0444\u043e\u0440\u043c\u0438\u0442\u044c \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0443 \u043d\u0430 \u043d\u043e\u0432\u043e\u0441\u0442\u0438 \u0438 \u043f\u0430\u043a\u0435\u0442\u044b \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f Skillz","You May Only Select One":"\u041c\u043e\u0436\u043d\u043e \u0432\u044b\u0431\u0440\u0430\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0434\u043d\u043e","You Placed {0}":"\u0412\u0430\u0448\u0435 \u043c\u0435\u0441\u0442\u043e: {0}","You Tied":"\u0412\u044b \u0421\u044b\u0433\u0440\u0430\u043b\u0438 \u0412\u043d\u0438\u0447\u044c\u044e","You are **{0} Tier** until **{1}**.":"\u0423 \u0432\u0430\u0441 **{0}-\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c** \u0434\u043e **{1}**.","You are already friends with this player.":"\u042d\u0442\u043e\u0442 \u0438\u0433\u0440\u043e\u043a \u0443\u0436\u0435 \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d \u043a \u0432\u0430\u0448\u0438\u043c \u0434\u0440\u0443\u0437\u044c\u044f\u043c.","You are already playing in a tournament with this group of players. Please check your Play tab":"\u0412\u044b \u0443\u0436\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442\u0435 \u0432 \u0442\u0443\u0440\u043d\u0438\u0440\u0435 \u0441 \u0434\u0430\u043d\u043d\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u043e\u0439. \u0412\u0437\u0433\u043b\u044f\u043d\u0438\u0442\u0435 \u043d\u0430 \u0432\u043a\u043b\u0430\u0434\u043a\u0443 \xab\u0418\u0433\u0440\u0430\xbb","You are already registered for a different tournament. Please complete or cancel that match before entering another.":"\u0412\u044b \u0443\u0436\u0435 \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u0438\u0441\u044c \u0434\u043b\u044f \u0443\u0447\u0430\u0441\u0442\u0438\u044f \u0432 \u0434\u0440\u0443\u0433\u043e\u043c \u0442\u0443\u0440\u043d\u0438\u0440\u0435. \u0414\u043b\u044f \u0443\u0447\u0430\u0441\u0442\u0438\u044f \u0432 \u0434\u0440\u0443\u0433\u043e\u043c \u0442\u0443\u0440\u043d\u0438\u0440\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0438\u043b\u0438 \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u0435 \u0442\u0435\u043a\u0443\u0449\u0438\u0439 \u043c\u0430\u0442\u0447.","You are not authorized to acccess contact data.":"\u0412\u044b \u043d\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u0435\u043d\u043e \u043f\u0440\u043e\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044c \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435.","You are now using {0} per entry.":"\u0422\u0435\u043f\u0435\u0440\u044c \u0432\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0435 {0} \u0437\u0430 \u0431\u0438\u043b\u0435\u0442.","You are ready to enter":"\u0412\u044b \u0433\u043e\u0442\u043e\u0432\u044b \u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u044c\u0441\u044f","You are ready to explore the tutorial until your event starts":"\u0412\u044b \u0433\u043e\u0442\u043e\u0432\u044b \u043f\u0440\u043e\u0439\u0442\u0438 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435, \u043f\u043e\u043a\u0430 \u043d\u0435 \u043d\u0430\u0447\u043d\u0451\u0442\u0441\u044f \u0441\u043e\u0431\u044b\u0442\u0438\u0435","You are registered.":"\u0412\u044b \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u044b.","You can also add friends directly from your address book.":"\u0414\u0440\u0443\u0437\u0435\u0439 \u0442\u0430\u043a\u0436\u0435 \u043c\u043e\u0436\u043d\u043e \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e \u0438\u0437 \u0430\u0434\u0440\u0435\u0441\u043d\u043e\u0439 \u043a\u043d\u0438\u0433\u0438.","You can also view your Ticketz details information by tapping your \"My Ticketz\".":"\u0414\u043b\u044f \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0430 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0445 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u0439 \u043e \u0441\u0432\u043e\u0438\u0445 Ticketz \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \"\u041c\u043e\u0438 Ticketz\".","You can always view your Ticketz tier information by tapping \"My Tier\".":"\u0412\u044b \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043e \u0441\u0432\u043e\u0451\u043c \u0443\u0440\u043e\u0432\u043d\u0435 Ticketz, \u043d\u0430\u0436\u0430\u0432 \"\u041c\u043e\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c\".","You can notify a user by adding @ in front of their username":"\u041c\u043e\u0436\u043d\u043e \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044e \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435, \u0434\u043e\u0431\u0430\u0432\u0438\u0432 @ \u043f\u0435\u0440\u0435\u0434 \u0438\u043c\u0435\u043d\u0435\u043c \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f.","You don't have enough funds to enter this match.":"\u0423 \u0432\u0430\u0441 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0434\u043b\u044f \u0443\u0447\u0430\u0441\u0442\u0438\u044f \u0432 \u044d\u0442\u043e\u043c \u043c\u0430\u0442\u0447\u0435.","You doubled your {0} winnings":"\u0412\u044b \u0443\u0434\u0432\u043e\u0438\u043b\u0438 \u0432\u044b\u0438\u0433\u0440\u044b\u0448 ({0})","You earned {0}{1} back":"\u0412\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438 {0}{1}","You have been banned from Chat":"\u0412\u0430\u043c \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u0447\u0430\u0442\u0443","You have been muted":"\u0412\u0430\u0448 \u0437\u0432\u0443\u043a \u043e\u0442\u043a\u043b\u044e\u0447\u0451\u043d","You have been muted.":"\u0412\u0430\u0448 \u0437\u0432\u0443\u043a \u043e\u0442\u043a\u043b\u044e\u0447\u0451\u043d.","You have blocked this player. Please unblock them before sending them a friend request.":"\u0412\u044b \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043b\u0438 \u044d\u0442\u043e\u0433\u043e \u0438\u0433\u0440\u043e\u043a\u0430. \u041f\u0435\u0440\u0435\u0434 \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u043e\u0439 \u0437\u0430\u043f\u0440\u043e\u0441\u0430 \u0432 \u0434\u0440\u0443\u0437\u044c\u044f \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0439\u0442\u0435 \u044d\u0442\u0438\u0445 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432.","You have completed your first deposit.\\nEnter your email address and a password\\nto save your account.":"\u0412\u044b \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u043f\u0435\u0440\u0432\u044b\u0439 \u0432\u0437\u043d\u043e\u0441!\\n\u0414\u043b\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u0443\u0447\u0451\u0442\u043d\u043e\u0439 \u0437\u0430\u043f\u0438\u0441\u0438\\n\u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u0430\u0434\u0440\u0435\u0441 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0439 \u043f\u043e\u0447\u0442\u044b \u0438 \u043f\u0430\u0440\u043e\u043b\u044c.","You have completed your first purchase. Enter your email address and a password to save your account.":"\u0412\u044b \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u043f\u0435\u0440\u0432\u0443\u044e \u043f\u043e\u043a\u0443\u043f\u043a\u0443. \u0414\u043b\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u0443\u0447\u0451\u0442\u043d\u043e\u0439 \u0437\u0430\u043f\u0438\u0441\u0438 \u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u0430\u0434\u0440\u0435\u0441 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0439 \u043f\u043e\u0447\u0442\u044b \u0438 \u043f\u0430\u0440\u043e\u043b\u044c.","You have earned `{0}` Ticketz in **{1}**.":"\u0412\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438 `{0}` Ticketz \u0432 **\xab{1}\xbb**.","You have exceeded your PayPal withdrawal limit. You may withdraw via Check.":"\u041b\u0438\u043c\u0438\u0442 \u0432\u044b\u0432\u043e\u0434\u0430 \u0447\u0435\u0440\u0435\u0437 PayPal \u043f\u0440\u0435\u0432\u044b\u0448\u0435\u043d. \u041c\u043e\u0436\u043d\u043e \u0432\u044b\u0432\u0435\u0441\u0442\u0438 \u0447\u0435\u043a\u043e\u043c.","You have no existing conversations":"\u0423 \u0432\u0430\u0441 \u043d\u0435\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0434\u0438\u0430\u043b\u043e\u0433\u043e\u0432","You have reached the limit of {0} blocked players.":"\u0412\u044b \u0434\u043e\u0441\u0442\u0438\u0433\u043b\u0438 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 {0} \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0438\u0433\u0440\u043e\u043a\u043e\u0432.","You have reached the limit of {0} friends.":"\u0412\u044b \u0434\u043e\u0441\u0442\u0438\u0433\u043b\u0438 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 {0} \u0434\u0440\u0443\u0437\u0435\u0439.","You have reached the limit of {0} muted messages.":"\u0412\u044b \u0434\u043e\u0441\u0442\u0438\u0433\u043b\u0438 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 {0} \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439 \u0441 \u043e\u0442\u043a\u043b\u044e\u0447\u0451\u043d\u043d\u044b\u043c \u0437\u0432\u0443\u043a\u043e\u043c.","You have reached the maximum number of entries for this tournament.":"\u0412\u044b \u0432\u043e\u0448\u043b\u0438 \u043d\u0430 \u0434\u0430\u043d\u043d\u044b\u0439 \u0442\u0443\u0440\u043d\u0438\u0440 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e \u0440\u0430\u0437.","You may only change your username once":"\u0418\u043c\u044f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u043c\u043e\u0436\u043d\u043e \u043c\u0435\u043d\u044f\u0442\u044c \u043b\u0438\u0448\u044c \u0440\u0430\u0437","You may only have 5 emails at a time":"\u041e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u043c\u043e\u0436\u043d\u043e \u0438\u043c\u0435\u0442\u044c 5 \u044d\u043b. \u0430\u0434\u0440\u0435\u0441\u043e\u0432","You may only have 5 emails at a time.":"\u041e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u043c\u043e\u0436\u043d\u043e \u0438\u043c\u0435\u0442\u044c 5 \u044d\u043b. \u0430\u0434\u0440\u0435\u0441\u043e\u0432.","You may withdraw up to {0} using PayPal":"\u041d\u0430 PayPal \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0432\u043e\u0434\u0438\u0442\u044c \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 {0}","You must add <b>{0}</b> as a Friend to play with them":"\u0414\u043b\u044f \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e\u0439 \u0438\u0433\u0440\u044b \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c <b>{0}</b> \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u0432 \u0434\u0440\u0443\u0437\u044c\u044f\u0445.","You must verify an email before withdrawing":"\u0414\u043e \u0432\u044b\u0432\u043e\u0434\u0430 \u043d\u0443\u0436\u043d\u043e \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044c \u044d\u043b. \u0430\u0434\u0440\u0435\u0441","You must verify your email address to perform this action. Please check your email and follow the instructions to complete the verification process":"\u0427\u0442\u043e\u0431\u044b \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u044d\u0442\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435, \u0432\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044c \u0430\u0434\u0440\u0435\u0441 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0439 \u043f\u043e\u0447\u0442\u044b. \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0430\u0434\u0440\u0435\u0441 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0439 \u043f\u043e\u0447\u0442\u044b \u0438 \u0441\u043b\u0435\u0434\u0443\u0439\u0442\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f\u043c, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044c \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435","You nudged {0}":"\u0412\u044b \u0431\u0443\u0434\u0438\u0442\u0435 \u0438\u0433\u0440\u043e\u043a\u0430 {0}","You placed 2nd and earned Ticketz!":"\u0412\u044b \u0437\u0430\u043d\u044f\u043b\u0438 2-\u0435 \u043c\u0435\u0441\u0442\u043e \u0438 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0435 Ticketz!","You played against Skillz Staff":"\u0412\u044b \u0441\u044b\u0433\u0440\u0430\u043b\u0438 \u043f\u0440\u043e\u0442\u0438\u0432 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430 Skillz","You tied! You can access the tie breaker game later from the Home Screen.":"\u041d\u0438\u0447\u044c\u044f! \u041f\u043e\u0437\u0436\u0435 \u0432\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u0440\u0435\u0448\u0430\u044e\u0449\u0435\u0439 \u0438\u0433\u0440\u0435 \u0441 \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u044d\u043a\u0440\u0430\u043d\u0430.","You will both be playing the same level.":"\u0412\u044b \u0438 \u0432\u0430\u0448 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a \u0431\u0443\u0434\u0435\u0442\u0435 \u0438\u0433\u0440\u0430\u0442\u044c \u043d\u0430 \u043e\u0434\u043d\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435.","You will not be registered until you tap 'Confirm Registration' on this page. Your entry fee/ticket will only be deducted then.":"\u0414\u043b\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043d\u0430\u0436\u0430\u0442\u044c \"\u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044c \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044e\" \u043d\u0430 \u0434\u0430\u043d\u043d\u043e\u0439 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435. \u0422\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u0431\u0443\u0434\u0443\u0442 \u0441\u043f\u0438\u0441\u0430\u043d\u044b \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043d\u0430 \u0432\u0441\u0442\u0443\u043f\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0432\u0437\u043d\u043e\u0441/\u0431\u0438\u043b\u0435\u0442.","You will not receive alerts for muted conversations.":"\u0412\u0430\u043c \u043d\u0435 \u0431\u0443\u0434\u0443\u0442 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u044c \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u0438\u0437 \u0434\u0438\u0430\u043b\u043e\u0433\u043e\u043c \u0441 \u043e\u0442\u043a\u043b\u044e\u0447\u0451\u043d\u043d\u044b\u043c \u0437\u0432\u0443\u043a\u043e\u043c.","You will not receive notifications for messages.":"\u0412\u044b \u043d\u0435 \u0431\u0443\u0434\u0435\u0442\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f \u043e \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f\u0445.","You will receive an email shortly with instructions on how to receive your prize.":"\u0412\u0441\u043a\u043e\u0440\u0435 \u0432\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0441 \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f\u043c\u0438 \u043f\u043e \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044e \u043f\u0440\u0438\u0437\u0430.","You won {0}{1}! Use these to enter practice tournaments.":"\u0412\u044b \u0432\u044b\u0438\u0433\u0440\u0430\u043b\u0438: {0}{1}! \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u044d\u0442\u043e \u0434\u043b\u044f \u0432\u0445\u043e\u0434\u0430 \u0432 \u0443\u0447\u0435\u0431\u043d\u044b\u0435 \u0442\u0443\u0440\u043d\u0438\u0440\u044b.","You'll need {0} for practice matches.":"\u0414\u043b\u044f \u0443\u0447\u0435\u0431\u043d\u044b\u0445 \u043c\u0430\u0442\u0447\u0435\u0439 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b {0}.","You'll need {0} to play matches.":"\u0414\u043b\u044f \u0443\u0447\u0430\u0441\u0442\u0438\u044f \u0432 \u043c\u0430\u0442\u0447\u0430\u0445 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b {0}.","You're Level {0} on Skillz!":"\u0412\u044b \u0434\u043e\u0441\u0442\u0438\u0433\u043b\u0438 \u0443\u0440\u043e\u0432\u043d\u044f {0} \u0432 Skillz!","You're Level {0}!":"\u0412\u044b \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 {0}!","You're doing that too much.":"\u0421\u043b\u0438\u0448\u043a\u043e\u043c \u0447\u0430\u0441\u0442\u043e.","You're doing that too much. Please wait.":"\u0412\u044b \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0447\u0430\u0441\u0442\u043e. \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043f\u043e\u0434\u043e\u0436\u0434\u0438\u0442\u0435.","You're {0}":"\u0412\u044b {0}","You've Leveled Up!":"\u0412\u0430\u0448 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u043f\u043e\u0432\u044b\u0448\u0435\u043d!","You've been invited to a tournament in {0}!":"\u0412\u0430\u0441 \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b\u0438 \u043d\u0430 \u0442\u0443\u0440\u043d\u0438\u0440! ({0})","You've been invited!":"\u0412\u0430\u0441 \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b\u0438!","You've been nudged by {0}!":"{0} \u0431\u0443\u0434\u0438\u0442 \u0432\u0430\u0441","You've been nudged in a tournament in {0}!":"\u0412\u0430\u0441 \u0431\u0443\u0434\u044f\u0442 \u043d\u0430 \u0442\u0443\u0440\u043d\u0438\u0440\u0435! ({0})","You've reached the max level!":"\u0412\u044b \u043f\u0435\u0440\u0435\u0448\u043b\u0438 \u043d\u0430 \u0432\u044b\u0441\u0448\u0438\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c!","You've sent friend requests to your contacts on Skillz already. Invite more friends to join you on Skillz!":"\u0412\u044b \u0443\u0436\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0438 \u0437\u0430\u043f\u0440\u043e\u0441\u044b \u043d\u0430 \u0434\u0440\u0443\u0436\u0431\u0443 \u0441\u0432\u043e\u0438\u043c \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0430\u043c \u0432 Skillz. \u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u0435 \u0432 Skillz \u043d\u043e\u0432\u044b\u0445 \u0434\u0440\u0443\u0437\u0435\u0439!","Your Bonus Cash balance of {0} will be forfeited if you proceed with this withdrawal.":"\u0412\u0430\u0448\u0438 \u0431\u043e\u043d\u0443\u0441\u043d\u044b\u0435 \u0434\u0435\u043d\u044c\u0433\u0438 ({0}) \u0431\u0443\u0434\u0443\u0442 \u0443\u0442\u0435\u0440\u044f\u043d\u044b \u043f\u0440\u0438 \u0434\u0430\u043d\u043d\u043e\u043c \u0432\u044b\u0432\u043e\u0434\u0435.","Your Friend":"\u0412\u0430\u0448 \u0434\u0440\u0443\u0433","Your Place":"\u0412\u0430\u0448\u0435 \u043c\u0435\u0441\u0442\u043e","Your Prize":"\u0412\u0430\u0448 \u043f\u0440\u0438\u0437","Your Skillz Level is a combination of all your gameplay across the Skillz Network.":"\u0412\u0430\u0448 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0432 Skillz \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0438\u0433\u0440\u044b \u0432 \u0441\u0435\u0442\u0438 Skillz.","Your best score determines your leaderboard ranking.":"\u0412\u0430\u0448\u0435 \u043c\u0435\u0441\u0442\u043e \u0432 \u0442\u0430\u0431\u043b\u0438\u0446\u0435 \u043b\u0438\u0434\u0435\u0440\u043e\u0432 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0432\u0430\u0448\u0435\u0433\u043e \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u0447\u0451\u0442\u0430.","Your connection strength is lower than recommended. If you disconnect during the match, you will forfeit your entry fee. Do you want to continue?":"\u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0441\u0435\u0442\u0435\u0432\u043e\u0433\u043e \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043d\u0438\u0436\u0435 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u043d\u043e\u0439. \u0412 \u0441\u043b\u0443\u0447\u0430\u0435 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u043c\u0430\u0442\u0447\u0430 \u0441\u0443\u043c\u043c\u0430 \u0432\u0430\u0448\u0435\u0433\u043e \u0432\u0441\u0442\u0443\u043f\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0437\u043d\u043e\u0441\u0430 \u0432\u043e\u0437\u0432\u0440\u0430\u0442\u0443 \u043d\u0435 \u043f\u043e\u0434\u043b\u0435\u0436\u0438\u0442. \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c?","Your connection strength is too weak to play this match.":"\u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0432\u0430\u0448\u0435\u0433\u043e \u0441\u0435\u0442\u0435\u0432\u043e\u0433\u043e \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u0430 \u0434\u043b\u044f \u0443\u0447\u0430\u0441\u0442\u0438\u044f \u0432 \u044d\u0442\u043e\u043c \u043c\u0430\u0442\u0447\u0435.","Your connection strength is too weak to play this match. Please connect to wifi or find a stronger signal.":"\u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0432\u0430\u0448\u0435\u0433\u043e \u0441\u0435\u0442\u0435\u0432\u043e\u0433\u043e \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u0430 \u0434\u043b\u044f \u0443\u0447\u0430\u0441\u0442\u0438\u044f \u0432 \u044d\u0442\u043e\u043c \u043c\u0430\u0442\u0447\u0435. \u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u0441\u044c \u043a \u0441\u0435\u0442\u0438 Wi-Fi \u0438\u043b\u0438 \u0434\u0440\u0443\u0433\u043e\u043c\u0443 \u0431\u043e\u043b\u0435\u0435 \u043c\u043e\u0449\u043d\u043e\u043c\u0443 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0443 \u0441\u0438\u0433\u043d\u0430\u043b\u0430.","Your deposit could not be processed at this time":"\u0412\u0437\u043d\u043e\u0441 \u043d\u0435 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u043d","Your deposit has been received!":"\u0412\u0430\u0448 \u0432\u0437\u043d\u043e\u0441 \u043f\u043e\u043b\u0443\u0447\u0435\u043d!","Your entered passwords do not match":"\u0412\u0432\u0435\u0434\u0451\u043d\u043d\u044b\u0435 \u043f\u0430\u0440\u043e\u043b\u0438 \u043d\u0435 \u0441\u043e\u0432\u043f\u0430\u0434\u0430\u044e\u0442","Your entries have been purchased!":"\u0412\u0430\u0448\u0438 \u0431\u0438\u043b\u0435\u0442\u044b \u043a\u0443\u043f\u043b\u0435\u043d\u044b!","Your entry fee has been refunded for:":"\u0412\u0430\u0448 \u0432\u0441\u0442\u0443\u043f\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0432\u0437\u043d\u043e\u0441 \u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d \u0434\u043b\u044f:","Your event":"\u0412\u0430\u0448\u0435 \u0441\u043e\u0431\u044b\u0442\u0438\u0435","Your event begins in {0}, would you like to be notified when it starts?":"\u0412\u0430\u0448\u0435 \u0441\u043e\u0431\u044b\u0442\u0438\u0435 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u0432 {0}. \u0425\u043e\u0442\u0438\u0442\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u043e \u043d\u0430\u0447\u043d\u0451\u0442\u0441\u044f?","Your event is now live!\\n\\nInvite more players using\\nthe match code:\\n":"\u0412\u0430\u0448\u0435 \u0441\u043e\u0431\u044b\u0442\u0438\u0435 \u0442\u0435\u043f\u0435\u0440\u044c \u0438\u0434\u0451\u0442 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438!\\n\\n\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u0435 \u0434\u0440\u0443\u0433\u0438\u0445 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e\\n\u043a\u043e\u0434\u0430 \u043c\u0430\u0442\u0447\u0430:\\n","Your free entries will be used first.":"\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0431\u0443\u0434\u0443\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u044b \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0435 \u0431\u0438\u043b\u0435\u0442\u044b.","Your friends are on Skillz! Tap add to send them a friend request.":"\u0412\u0430\u0448\u0438 \u0434\u0440\u0443\u0437\u044c\u044f \u0432 Skillz! \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0437\u0430\u043f\u0440\u043e\u0441 \u0432 \u0434\u0440\u0443\u0437\u044c\u044f.","Your hard work has earned you a {0}X Ticketz multiplier. Check out Skillz Rewards to redeem Ticketz for amazing prizes!":"\u0412\u044b \u043e\u0442\u043b\u0438\u0447\u043d\u043e \u043f\u0440\u043e\u044f\u0432\u0438\u043b\u0438 \u0441\u0435\u0431\u044f \u0432 \u0438\u0433\u0440\u0435 \u0438 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0435 \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442 Ticketz ?{0}. \u0417\u0430\u0445\u043e\u0434\u0438\u0442\u0435 \u0432 \xab\u041d\u0430\u0433\u0440\u0430\u0434\u044b Skillz\xbb \u0438 \u043e\u0431\u043c\u0435\u043d\u0438\u0432\u0430\u0439\u0442\u0435 Ticketz \u043d\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0438\u0437\u044b!","Your level represents all your hard work and gameplay in {0}":"\u0412\u0430\u0448 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0438\u0433\u0440\u043e\u0432\u044b\u0445 \u0443\u0441\u043f\u0435\u0445\u043e\u0432 ({0})","Your match history is summarized here.":"\u0417\u0434\u0435\u0441\u044c \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0432\u0430\u0448\u0438\u0445 \u043c\u0430\u0442\u0447\u0435\u0439.","Your opponent has cancelled.":"\u041c\u0430\u0442\u0447 \u043e\u0442\u043c\u0435\u043d\u0435\u043d \u0432\u0430\u0448\u0438\u043c \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u043e\u043c.","Your primary email address is used for login and player communications":"\u041e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u044d\u043b. \u0430\u0434\u0440\u0435\u0441 \u043d\u0443\u0436\u0435\u043d \u0434\u043b\u044f \u0432\u0445\u043e\u0434\u0430 \u0438 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0438 \u0441 \u043d\u0430\u043c\u0438.","Your rematch was declined":"\u0412\u0430\u0448 \u043c\u0430\u0442\u0447-\u0440\u0435\u0432\u0430\u043d\u0448 \u043e\u0442\u043a\u043b\u043e\u043d\u0451\u043d","Your secondary email must be verified before it can be made the primary account email.":"\u041f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0432\u0442\u043e\u0440\u043e\u0439 \u044d\u043b. \u0430\u0434\u0440\u0435\u0441 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u043c, \u0435\u0433\u043e \u043d\u0443\u0436\u043d\u043e \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044c.","Your withdrawal request has been completed. You will receive an email confirming the transaction.":"\u0417\u0430\u043f\u0440\u043e\u0441 \u043d\u0430 \u0432\u044b\u0432\u043e\u0434 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d, \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e \u043f\u0438\u0441\u044c\u043c\u043e \u043e \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0435.","Your {0} Tier Benefits":"\u041f\u0440\u0438\u0432\u0438\u043b\u0435\u0433\u0438\u0438 \u0432\u0430\u0448\u0435\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f {0}","Youa\u20ac\u2122ve found an opponent! Tap PLAY before the timer runs down to confirm your match.":"\u041d\u0430\u0439\u0434\u0435\u043d \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u043a! \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \xab\u0418\u0413\u0420\u0410\u0422\u042c\xbb \u0434\u043e \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f \u0442\u0430\u0439\u043c\u0435\u0440\u0430, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044c \u043c\u0430\u0442\u0447.","Youa\u20ac\u2122ve reached the maximum limit for number of events created, please try again later!":"\u0412\u044b \u0441\u043e\u0437\u0434\u0430\u043b\u0438 \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c \u0441\u043e\u0431\u044b\u0442\u0438\u0439. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u043f\u043e\u0437\u0436\u0435!",ZIP:"\u0418\u043d\u0434\u0435\u043a\u0441","a eighth time":"\u0432\u043e\u0441\u044c\u043c\u043e\u0439 \u0440\u0430\u0437","a fifth time":"\u043f\u044f\u0442\u044b\u0439 \u0440\u0430\u0437","a fourth time":"\u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044b\u0439 \u0440\u0430\u0437","a ninth time":"\u0434\u0435\u0432\u044f\u0442\u044b\u0439 \u0440\u0430\u0437","a player":"\u0438\u0433\u0440\u043e\u043a","a second time":"\u0432\u0442\u043e\u0440\u043e\u0439 \u0440\u0430\u0437","a seventh time":"\u0441\u0435\u0434\u044c\u043c\u043e\u0439 \u0440\u0430\u0437","a sixth time":"\u0448\u0435\u0441\u0442\u043e\u0439 \u0440\u0430\u0437","a tenth time":"\u0434\u0435\u0441\u044f\u0442\u044b\u0439 \u0440\u0430\u0437","a third time":"\u0442\u0440\u0435\u0442\u0438\u0439 \u0440\u0430\u0437","and get":"\u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435","badge to your profile! Now other players will be able to see your achievement.":"\u0432 \u0432\u0430\u0448 \u043f\u0440\u043e\u0444\u0438\u043b\u044c! \u0422\u0435\u043f\u0435\u0440\u044c \u0434\u0440\u0443\u0433\u0438\u0435 \u0438\u0433\u0440\u043e\u043a\u0438 \u0442\u043e\u0436\u0435 \u0441\u043c\u043e\u0433\u0443\u0442 \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0432\u0430\u0448\u0438 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f.",city:"\u0433\u043e\u0440\u043e\u0434","credit card number":"\u043d\u043e\u043c\u0435\u0440 \u043a\u0440\u0435\u0434\u0438\u0442\u043d\u043e\u0439 \u043a\u0430\u0440\u0442\u044b","eSports Tournament":"\u0422\u0443\u0440\u043d\u0438\u0440 eSports","email address":"\u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u044b\u0439 \u0430\u0434\u0440\u0435\u0441",expiration:"\u0438\u0441\u0442\u0435\u0447\u0435\u043d\u0438\u0435","for a ":"\u0437\u0430 ",hello:"\u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435","image attached":"\u043f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u0451\u043d\u043d\u043e\u0435 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435","max user limit reached":"\u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u0442\u043e \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439","more rewards":"\u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0430\u0433\u0440\u0430\u0434",player:"\u0438\u0433\u0440\u043e\u043a",players:"\u0438\u0433\u0440\u043e\u043a\u0438","postal code":"\u043f\u043e\u0447\u0442\u043e\u0432\u044b\u0439 \u0438\u043d\u0434\u0435\u043a\u0441","the next time":"\u0432 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0440\u0430\u0437","with a {0}":"\u0441 {0}","your friend":"\u0432\u0430\u0448 \u0434\u0440\u0443\u0433","{0} - {1} Entries Left{2}":"\u041e\u0441\u