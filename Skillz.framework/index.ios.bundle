d you in {0} on Skillz. Use match code \"{1}\" [{2}]":"\u0414\u0440\u0443\u0433 \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0430\u0435\u0442 \u0441\u044b\u0433\u0440\u0430\u0442\u044c \u0432 Skillz ({0}). \u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043a\u043e\u0434 \u043c\u0430\u0442\u0447\u0430 \"{1}\" [{2}]","A friend request has already been sent to {0}.":"\u0417\u0430\u043f\u0440\u043e\u0441 \u043d\u0430 \u0434\u0440\u0443\u0436\u0431\u0443 \u0443\u0436\u0435 \u0432\u044b\u0441\u043b\u0430\u043d \u0438\u0433\u0440\u043e\u043a\u0443 {0}",ABORTED:"\u041f\u0420\u0415\u041a\u0420\u0410\u0429\u0415\u041d\u041e",ACCEPT:"\u041f\u0420\u0418\u041d\u042f\u0422\u042c","ACCOUNT BALANCE":"\u0411\u0410\u041b\u0410\u041d\u0421","ACTION RESTRICTED":"\u0414\u0415\u0419\u0421\u0422\u0412\u0418\u0415 \u0417\u0410\u041f\u0420\u0415\u0429\u0415\u041d\u041e","ADD CONTACTS":"\u0414\u041e\u0411\u0410\u0412\u0418\u0422\u042c \u041a\u041e\u041d\u0422\u0410\u041a\u0422\u042b","ADD FRIEND":"\u0414\u041e\u0411\u0410\u0412\u0418\u0422\u042c \u0414\u0420\u0423\u0413\u0410","ADD FRIENDS":"\u0414\u041e\u0411\u0410\u0412\u0418\u0422\u042c \u0414\u0420\u0423\u0417\u0415\u0419","ADD FROM CONTACTS":"\u0414\u041e\u0411\u0410\u0412\u0418\u0422\u042c \u0418\u0417 \u041a\u041e\u041d\u0422\u0410\u041a\u0422\u041e\u0412","ADD FUNDS":"\u041f\u041e\u041f\u041e\u041b\u041d\u0418\u0422\u042c \u0421\u0420\u0415\u0414\u0421\u0422\u0412\u0410","AUDIO SETTINGS":"\u041d\u0410\u0421\u0422\u0420\u041e\u0419\u041a\u0418 \u0417\u0412\u0423\u041a\u0410",Aborted:"\u041f\u0440\u0435\u043a\u0440\u0430\u0449\u0435\u043d\u043e",Accept:"\u041f\u0440\u0438\u043d\u044f\u0442\u044c","Accept their request to start a conversation!":"\u041f\u0440\u0438\u043d\u044f\u0442\u044c \u0437\u0430\u043f\u0440\u043e\u0441 \u043d\u0430 \u043d\u0430\u0447\u0430\u043b\u043e \u0434\u0438\u0430\u043b\u043e\u0433\u0430!",Account:"\u0423\u0447\u0451\u0442\u043d\u0430\u044f \u0437\u0430\u043f\u0438\u0441\u044c","Account Balance":"\u0411\u0430\u04